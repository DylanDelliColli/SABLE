#!/usr/bin/env python3
"""sable-dev-check — proportional local feedback before sealed-candidate CI."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import sable_dev_check_lib as devcheck  # noqa: E402
import sable_test_cost_profile_lib as profile_lib  # noqa: E402


def _repo_root() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        raise devcheck.DeveloperCheckError(f"git is unavailable: {exc}") from exc
    if result.returncode != 0:
        raise devcheck.DeveloperCheckError(
            result.stderr.strip() or "not inside a git repository"
        )
    return Path(result.stdout.strip())


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sable-dev-check",
        description=(
            "Run deterministic changed-module feedback locally. This does not "
            "replace the complete sealed-candidate ci-verify suite."
        ),
    )
    parser.add_argument(
        "--base",
        help="include commits in BASE...HEAD, plus staged/unstaged/untracked files",
    )
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        help="plan for this changed path instead of reading git (repeatable)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the deterministic plan without executing tests",
    )
    parser.add_argument(
        "--budget",
        type=float,
        default=None,
        metavar="SECONDS",
        help=(
            "explicit absolute execution bound (implicit: the full_snapshot "
            "tier budget; within it, per-command budgets are derived from "
            "measured suite cost)"
        ),
    )
    parser.add_argument(
        "--cost-report",
        default=None,
        metavar="PATH",
        help=(
            "raw Python cost report (pytest --sable-test-cost-report) as a "
            "DIAGNOSTIC override; must be paired with --shell-profile. The "
            "default read is the shared canonical store in the git common "
            "dir (publish it with --publish-cost-profile)."
        ),
    )
    parser.add_argument(
        "--shell-profile",
        default=None,
        metavar="PATH",
        help=(
            "raw shell cost profile (shell-run-set.sh --profile) as a "
            "DIAGNOSTIC override; must be paired with --cost-report. The "
            "default read is the shared canonical store in the git common "
            "dir."
        ),
    )
    parser.add_argument(
        "--no-derived-budget",
        action="store_true",
        help=(
            "ignore measured cost and run under one flat bound. Diagnostic "
            "only: this is the pre-derivation behaviour that could exit 124 "
            "with nothing verified."
        ),
    )
    parser.add_argument(
        "--publish-cost-profile",
        action="store_true",
        help=(
            "run BOTH producers serially (full pytest + full shell profile) "
            "and atomically publish the shared machine-local cost profile in "
            "the git common dir. Expensive; run ONE per host in a coordinated "
            "quiet window (the broad seat when a fleet exists, the "
            "standalone runner otherwise). Exclusive of "
            "every planning flag."
        ),
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.publish_cost_profile:
        # v2.1 B8: the publisher mode is EXCLUSIVE of every planning flag —
        # it measures the whole catalog, it does not plan a subset.
        planning = [
            args.base is not None, bool(args.path), args.dry_run,
            args.budget is not None, args.cost_report is not None,
            args.shell_profile is not None, args.no_derived_budget,
        ]
        if any(planning):
            parser.error(
                "--publish-cost-profile cannot be combined with planning "
                "flags (--base/--path/--dry-run/--budget/--cost-report/"
                "--shell-profile/--no-derived-budget)"
            )
        try:
            profile = profile_lib.publish(_repo_root())
        except (
            profile_lib.ProfilePublishError, devcheck.DeveloperCheckError,
        ) as exc:
            print(f"sable-dev-check: publish refused: {exc}", file=sys.stderr)
            return 2
        print(
            "sable-dev-check: published shared cost profile — "
            f"{len(profile['python_costs'])} python module(s), "
            f"{len(profile['shell_costs'])} shell suite(s), "
            f"{len(profile['provisional_python'])} provisional",
            flush=True,
        )
        return 0
    if args.budget is not None and args.budget <= 0:
        parser.error("--budget must be positive")
    # The single marker-finalization seam (SABLE-y4nom.7.2): whatever exit
    # path this call takes, an omission-carrying plan re-emits its marker as
    # the LAST stdout line — run_plan's own emissions can be followed by
    # precondition text, so main owns finality.
    budget = None
    try:
        repo = _repo_root()
        changed = (
            tuple(args.path)
            if args.path
            else devcheck.collect_changed_paths(repo, args.base)
        )
        plan = devcheck.build_plan(repo, changed)
        costs = (
            None
            if args.no_derived_budget
            else devcheck.load_costs(
                repo,
                python_report=args.cost_report,
                shell_profile=args.shell_profile,
            )
        )
        budget = devcheck.effective_budget(
            repo,
            plan,
            explicit_seconds=args.budget,
            costs=costs,
            derived=not args.no_derived_budget,
        )
        print(
            devcheck.render_plan(
                plan,
                max_entries=None if args.dry_run else 20,
                budget=budget,
            ),
            flush=True,
        )
        if args.dry_run:
            if budget.omitted:
                # An omitting plan is not a green plan, even unexecuted.
                devcheck.emit_incomplete_marker(budget.omitted)
                return devcheck.EXIT_INCOMPLETE_BY_TRIM
            return 0
        return devcheck.run_plan(
            repo, plan, budget_seconds=budget.seconds, budget=budget,
        )
    except devcheck.DeveloperCheckError as exc:
        print(f"sable-dev-check: precondition failed: {exc}", file=sys.stderr)
        if budget is not None and budget.omitted:
            devcheck.emit_incomplete_marker(budget.omitted)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
