#!/usr/bin/env python3
"""sable-dev-check — proportional local feedback before sealed-candidate CI."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import sable_dev_check_lib as devcheck  # noqa: E402


def _repo_root() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        raise devcheck.DeveloperCheckError(f"git is unavailable: {exc}") from exc
    if result.returncode != 0:
        raise devcheck.DeveloperCheckError(
            result.stderr.strip() or "not inside a git repository"
        )
    return Path(result.stdout.strip())


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sable-dev-check",
        description=(
            "Run deterministic changed-module feedback locally. This does not "
            "replace the complete sealed-candidate ci-verify suite."
        ),
    )
    parser.add_argument(
        "--base",
        help="include commits in BASE...HEAD, plus staged/unstaged/untracked files",
    )
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        help="plan for this changed path instead of reading git (repeatable)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the deterministic plan without executing tests",
    )
    parser.add_argument(
        "--budget",
        type=float,
        default=None,
        metavar="SECONDS",
        help=(
            "explicit absolute execution bound (implicit: the full_snapshot "
            "tier budget; within it, per-command budgets are derived from "
            "measured suite cost)"
        ),
    )
    parser.add_argument(
        "--cost-report",
        default=None,
        metavar="PATH",
        help=(
            "Python suite cost report from pytest --sable-test-cost-report "
            f"(default: {devcheck.PYTHON_COST_REPORT})"
        ),
    )
    parser.add_argument(
        "--shell-profile",
        default=None,
        metavar="PATH",
        help=(
            "shell suite cost profile from shell-run-set.sh --profile "
            f"(default: {devcheck.SHELL_COST_PROFILE})"
        ),
    )
    parser.add_argument(
        "--no-derived-budget",
        action="store_true",
        help=(
            "ignore measured cost and run under one flat bound. Diagnostic "
            "only: this is the pre-derivation behaviour that could exit 124 "
            "with nothing verified."
        ),
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.budget is not None and args.budget <= 0:
        parser.error("--budget must be positive")
    try:
        repo = _repo_root()
        changed = (
            tuple(args.path)
            if args.path
            else devcheck.collect_changed_paths(repo, args.base)
        )
        plan = devcheck.build_plan(repo, changed)
        costs = (
            None
            if args.no_derived_budget
            else devcheck.load_costs(
                repo,
                python_report=args.cost_report,
                shell_profile=args.shell_profile,
            )
        )
        budget = devcheck.effective_budget(
            repo,
            plan,
            explicit_seconds=args.budget,
            costs=costs,
            derived=not args.no_derived_budget,
        )
        print(
            devcheck.render_plan(
                plan,
                max_entries=None if args.dry_run else 20,
                budget=budget,
            ),
            flush=True,
        )
        if args.dry_run:
            return 0
        return devcheck.run_plan(
            repo, plan, budget_seconds=budget.seconds, budget=budget,
        )
    except devcheck.DeveloperCheckError as exc:
        print(f"sable-dev-check: precondition failed: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
