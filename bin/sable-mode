#!/usr/bin/env python3
"""Read and transition SABLE's per-repository orchestration mode state.

The CLI is intentionally thin. ``sable_mode_store_lib`` owns path resolution,
schema validation, serialization, provider immutability, and atomic
read-modify-write transitions.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

from sable_handoff_lib import (
    HandoffRefused,
    approval_actor,
    approve_handoff,
    break_glass_authority,
    validate_execution_authority,
    validate_handoff,
    validate_handoff_state,
)
from sable_mode_store_lib import (
    PLANNING_SUBSTAGES,
    ModeStateCorrupt,
    ModeStateMissing,
    ModeTransitionRefused,
    advance_planning_substage,
    clear_mode_state,
    read_mode_state,
    resolve_mode_state_path,
    set_mode_state,
    set_planning_substage,
)
from sable_provider_lib import (
    ProviderMapError,
    format_provider_map,
    parse_provider_map,
    provider_for_role,
    provider_map_from_state,
)


def _parser(state_path: Path) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sable-mode",
        description=(
            "Read or atomically transition the per-repository SABLE "
            "orchestration mode state."
        ),
        epilog=(
            f"State file: {state_path}\n"
            "Override with SABLE_MODE_STATE; disable transitions with "
            "SABLE_ORCHESTRATION=off."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    commands = parser.add_subparsers(dest="command", required=True)

    set_parser = commands.add_parser("set", help="set planning or execution mode")
    set_parser.add_argument("mode", choices=("planning", "execution"))
    set_parser.add_argument(
        "--fleet", default="",
        help="comma-separated launched agent names recorded for the dashboard",
    )
    set_parser.add_argument(
        "--tier", default="full", choices=("quick", "full", "discovery"),
        help="planning tier (default: full)",
    )
    set_parser.add_argument(
        "--providers", default=None,
        help=(
            "execution-only role=provider CSV for "
            "optimus,tarzan,chuck,worker"
        ),
    )
    set_parser.add_argument(
        "--break-glass",
        action="store_true",
        help="bypass planning proof and persist an explicit audited authority",
    )
    set_parser.add_argument(
        "--reason",
        help="required nonblank explanation for --break-glass",
    )

    commands.add_parser("get", help="print the active mode")
    commands.add_parser("show", help="print the complete validated state")
    commands.add_parser(
        "snapshot",
        help="print validated mode, tier, and substage ('-' when absent)",
    )
    commands.add_parser("path", help="print the resolved state path")
    commands.add_parser("clear", help="clear state, including corrupt state")

    substage = commands.add_parser(
        "substage", help="read or transition the planning substage"
    )
    subcommands = substage.add_subparsers(dest="substage_command", required=True)
    subcommands.add_parser("get")
    substage_set = subcommands.add_parser("set")
    substage_set.add_argument("name", choices=PLANNING_SUBSTAGES)
    subcommands.add_parser("advance")

    tier = commands.add_parser("tier", help="read the planning tier")
    tier_commands = tier.add_subparsers(dest="tier_command", required=True)
    tier_commands.add_parser("get")

    providers = commands.add_parser(
        "providers", help="read the execution provider map"
    )
    provider_commands = providers.add_subparsers(
        dest="providers_command", required=True
    )
    provider_get = provider_commands.add_parser("get")
    provider_get.add_argument(
        "role", nargs="?", choices=("optimus", "tarzan", "chuck", "worker")
    )

    handoff = commands.add_parser(
        "handoff", help="approve or inspect planning handoff proof"
    )
    handoff_commands = handoff.add_subparsers(
        dest="handoff_command", required=True
    )
    handoff_approve = handoff_commands.add_parser(
        "approve", help="record the final human planning approval"
    )
    handoff_scope = handoff_approve.add_mutually_exclusive_group(required=True)
    handoff_scope.add_argument(
        "--beads", help="quick-tier comma-separated scope (1-3 bead IDs)"
    )
    handoff_scope.add_argument("--epic", help="full-tier epic ID")
    handoff_commands.add_parser("show", help="print the embedded receipt")
    return parser


def _orchestration_enabled() -> bool:
    return os.environ.get("SABLE_ORCHESTRATION", "").lower() not in {
        "off", "0", "false", "no"}


def _ensure_state_gitignored(state_path: Path) -> None:
    """Best-effort protection for canonical repository-local runtime state."""

    suffix = Path(".claude/sable/state/mode-state.json")
    try:
        root = state_path.parents[3]
    except IndexError:
        return
    if state_path != root / suffix or not (root / ".git").exists():
        return
    gitignore = root / ".gitignore"
    pattern = ".claude/sable/state/"
    try:
        existing = gitignore.read_text(encoding="utf-8") if gitignore.exists() else ""
        if ".claude/sable/" not in existing:
            with gitignore.open("a", encoding="utf-8") as handle:
                handle.write(pattern + "\n")
    except OSError:
        pass


def _warn_if_stale(state: dict) -> None:
    since = state.get("since") or ""
    if not since:
        return
    try:
        timestamp = datetime.strptime(since, "%Y-%m-%dT%H:%M:%S%z")
        age_hours = (
            datetime.now(timezone.utc) - timestamp.astimezone(timezone.utc)
        ).total_seconds() / 3600.0
        threshold = float(os.environ.get("SABLE_MODE_STALE_HOURS", "72"))
    except (TypeError, ValueError):
        return
    if age_hours > threshold:
        print(
            "sable-mode: WARNING - mode-state is stale "
            f"({age_hours / 24.0:.1f}d old, mode={state.get('mode') or '?'}, "
            f"since {since}) - if this session has ended, run 'sable-mode clear'",
            file=sys.stderr,
        )


def _read_planning_state(path: Path) -> dict:
    state = read_mode_state(path)
    if state.get("mode") != "planning":
        raise ModeTransitionRefused("planning state is not active")
    return state


def _read_execution_state(path: Path) -> dict:
    state = read_mode_state(path)
    if state.get("mode") != "execution":
        raise ModeTransitionRefused("execution state is not active")
    return state


def _run(args: argparse.Namespace, path: Path) -> int:
    if args.command == "path":
        print(path)
        return 0
    if args.command == "clear":
        clear_mode_state(path)
        print(f"sable-mode: cleared mode-state at {path}")
        return 0
    if args.command == "get":
        state = read_mode_state(path)
        _warn_if_stale(state)
        print(state["mode"])
        return 0
    if args.command == "show":
        print(json.dumps(read_mode_state(path), indent=2))
        return 0
    if args.command == "snapshot":
        state = read_mode_state(path)
        print(state["mode"])
        print(state.get("tier") or "-")
        print(state.get("substage") or "-")
        return 0
    if args.command == "set":
        if not _orchestration_enabled():
            print(
                "sable-mode: orchestration disabled "
                f"(SABLE_ORCHESTRATION={os.environ.get('SABLE_ORCHESTRATION', '')}); "
                "unset SABLE_ORCHESTRATION to enable",
                file=sys.stderr,
            )
            return 3
        if args.mode == "planning" and args.providers is not None:
            print(
                "sable-mode: --providers is valid only for execution mode",
                file=sys.stderr,
            )
            return 2
        if args.mode == "planning" and (args.break_glass or args.reason):
            print(
                "sable-mode: break-glass is valid only for execution mode",
                file=sys.stderr,
            )
            return 2
        if args.reason and not args.break_glass:
            print(
                "sable-mode: --reason requires --break-glass",
                file=sys.stderr,
            )
            return 2
        if args.break_glass and not (args.reason or "").strip():
            print(
                "sable-mode: --break-glass requires a nonblank --reason",
                file=sys.stderr,
            )
            return 2
        try:
            providers = (
                parse_provider_map(args.providers)
                if args.mode == "execution"
                else None
            )
        except ProviderMapError as exc:
            print(f"sable-mode: {exc}", file=sys.stderr)
            return 2

        authority = None
        authority_validator = None
        if args.mode == "execution":
            if args.break_glass:
                failed_checks: list[str] = []
                try:
                    validate_handoff(path)
                except HandoffRefused as exc:
                    failed_checks.append(str(exc))
                authority = break_glass_authority(
                    approved_by=approval_actor(),
                    reason=args.reason,
                    failed_checks=failed_checks,
                )
            else:
                try:
                    current = read_mode_state(path)
                except ModeStateMissing:
                    current = None
                if current is None or current.get("mode") != "execution":
                    authority_validator = lambda locked_state: (
                        validate_handoff_state(path, locked_state)
                    )
        set_mode_state(
            path,
            args.mode,
            fleet=tuple(member for member in args.fleet.split(",") if member),
            tier=args.tier,
            providers=providers,
            handoff=authority,
            handoff_validator=authority_validator,
        )
        _ensure_state_gitignored(path)
        return 0
    if args.command == "substage":
        if args.substage_command == "get":
            state = _read_planning_state(path)
            substage = state.get("substage")
            if not substage:
                raise ModeTransitionRefused("planning state has no substage")
            print(substage)
            return 0
        if args.substage_command == "set":
            set_planning_substage(path, args.name)
            return 0
        if args.substage_command == "advance":
            advance_planning_substage(path)
            return 0
    if args.command == "tier":
        print(_read_planning_state(path).get("tier") or "full")
        return 0
    if args.command == "providers":
        state = _read_execution_state(path)
        if args.role:
            print(provider_for_role(state, args.role))
        else:
            print(format_provider_map(provider_map_from_state(state)))
        return 0
    if args.command == "handoff":
        if args.handoff_command == "approve":
            receipt = approve_handoff(
                path,
                approved_by=approval_actor(),
                beads=tuple(
                    bead.strip()
                    for bead in (args.beads or "").split(",")
                    if bead.strip()
                ),
                epic=args.epic,
            )
            print(json.dumps(receipt, indent=2))
            return 0
        state = read_mode_state(path)
        if state.get("mode") == "planning":
            receipt = state.get("handoff")
            if not isinstance(receipt, dict):
                raise HandoffRefused("planning state has no handoff receipt")
        else:
            # Fleet start trusts validate_execution_authority through
            # read_execution_authority.  Showing a carried receipt must use the
            # same validator—not a second execution-shaped parser—so malformed
            # or statusless proof can never render as authoritative scope.
            try:
                receipt = validate_execution_authority(state)
            except HandoffRefused as exc:
                raise HandoffRefused(
                    f"CANNOT-ASSESS handoff receipt: {exc}"
                ) from exc
        print(json.dumps(receipt, indent=2))
        return 0
    return 2


def main(argv: list[str] | None = None) -> int:
    path = resolve_mode_state_path()
    args = _parser(path).parse_args(argv)
    try:
        return _run(args, path)
    except ModeStateMissing:
        print(
            f"sable-mode: no mode set (no state file at {path})",
            file=sys.stderr,
        )
        return 1
    except ModeStateCorrupt as exc:
        print(
            f"sable-mode: {exc}. Run `sable-mode clear` to remove the corrupt "
            "state before starting a new session.",
            file=sys.stderr,
        )
        return 5
    except ModeTransitionRefused as exc:
        print(f"sable-mode: {exc}", file=sys.stderr)
        return 4 if "provider map is immutable" in str(exc) else 1
    except ProviderMapError as exc:
        print(f"sable-mode: {exc}", file=sys.stderr)
        return 2
    except HandoffRefused as exc:
        print(f"sable-mode: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
