#!/usr/bin/env python3
"""sable-spawn-manager — stand up manager panes on demand (SABLE-dqhn.2).

sable-launch starts a Lincoln-only session (mode-neutral); THIS tool adds the
execution fleet when execution actually begins — normally driven by
/sable-execute, gated to execution mode by the mode-interlock. Each manager
opens as a DETACHED tmux window (never a split — the Lincoln window the
operator is looking at is not disturbed), with its identity env, a bypass
permission posture, the @sable_role tag, and its operating-loop kick
(shared with sable-tmux --autostart via sable_pane_lib).

This same helper also spawns bounded PRODUCER panes (SABLE-tz7h.1) — single-shot
analysis roles like victor that write one deliverable and stop, rather than
looping managers. A producer's kick carries only the lifecycle contract (write
deliverable, flag done, exit); its task brief arrives separately via sable-msg
once the pane is ready.

Usage:
  sable-spawn-manager <role> [role...]     roles: optimus | tarzan | chuck
  sable-spawn-manager --all                all three
  sable-spawn-manager victor --deliverable PATH [--model TIER]
                                            bounded producer (--deliverable required)

Env: SABLE_TMUX_SESSION (default: sable), SABLE_TMUX_SOCKET (tmux -L),
     SABLE_TMUX_PANE_CMD (stand-in command; tests), SABLE_WORKER_PERMISSION,
     SABLE_DISPATCH_READY_TIMEOUT / _SUBMIT_TRIES / _POLL_INTERVAL.
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from enum import Enum, auto
from pathlib import Path
from typing import Callable, NamedTuple

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from sable_pane_lib import (  # noqa: E402
    KICK_TAG, SessionCollision, capture_pane, deliver_text,
    dialog_posture, git_common_dir, kick_message, repo_root, resolve_session,
    wait_for_ready, with_lifecycle_flags,
)
from sable_handoff_lib import (  # noqa: E402
    HandoffRefused, read_execution_authority,
)
from sable_provider_lib import (  # noqa: E402
    DEFAULT_PROVIDER, ProviderMapError, execution_provider, interactive_command,
    pane_environment, provider_boot_message, validate_codex_hook_graph,
)
from sable_registry_lib import (  # noqa: E402
    FLEET_PROJECT_ONLY_REMEDY, fleet_project_only, sable_registry_path,
)

VALID_ROLES = ("optimus", "tarzan", "chuck")

# Producer roles (SABLE-tz7h.1, architecture.json decisions 1+2): bounded,
# single-shot analysis panes spawned through this SAME helper rather than a
# sibling script (avoids Duplicate Code — one module owns windows/readiness/
# kick/registry for every pane class). v1 scope is victor-only; sherlock/columbo
# adopt fan-out later only if the wedge beats the baseline (Speculative
# Generality guard, decision 6).
PRODUCER_ROLES = ("victor",)
ALL_ROLES = VALID_ROLES + PRODUCER_ROLES
DEFAULT_PRODUCER_MODEL = "sonnet"


class PaneLiveness(Enum):
    """Three actionable manager states plus an out-of-domain refusal.

    UNKNOWN is deliberately not a fourth action: without an agent-written boot
    epoch (or without the pane-local lifecycle bit) the trichotomy's
    preconditions are not met, so the caller must refuse without mutation.
    """

    ALIVE_AND_SESSIONED = auto()
    RESTARTED_SINCE = auto()
    DEAD = auto()
    UNKNOWN = auto()


class SpawnAction(Enum):
    SPAWN_NEW = auto()
    SKIP_ALIVE = auto()
    REKICK_RESTARTED = auto()
    RESPAWN_DEAD = auto()
    ADOPT_REFERENCE = auto()
    REFUSE_UNKNOWN = auto()


class ExistingPane(NamedTuple):
    pane_id: str
    role: str
    provider: str
    pane_dead: bool
    status: str
    boot_epoch: str
    kicked_epoch: str

# --- Instance-entry registry writer (market-brief-package-73t4, Lincoln ruling
# 2026-07-07, mechanism (b) EXPLICIT INSTANCE REGISTRATION). When a manager role
# is spawned/respawned as a SECOND live instance, the harness may assign an
# instance-suffixed identity (tarzan-2, optimus-3). lib-identity.sh resolves a
# manager ONLY via an exact agents.yaml key match (privilege NEVER derives from a
# name pattern), so an unregistered 'tarzan-2' resolves as a worker and the
# pre-push gate denies its push. The FIX is here, in the spawn tooling: at spawn
# time we WRITE the instance's own agents.yaml entry (mirroring its base
# manager's type), so the UNCHANGED exact-match lookup resolves it. The running
# session never registers itself (constraint 2); this writer is spawn-tooling
# only and is wired into no hook.
MANAGER_TYPES = {"epic_manager", "one_off_manager", "integrator", "strategist",
                 "cockpit"}

# A trailing -<digits> is a spawn-assigned instance suffix. Used ONLY at WRITE
# time (to find the base entry to mirror) and for diagnostics — NEVER to grant
# privilege at resolution time.
_INSTANCE_RE = re.compile(r"^(?P<base>.+)-(?P<n>\d+)$")


def agents_yaml_path() -> str:
    """Runtime registry path — project-first resolver shared with the hooks
    (SABLE_AGENTS_YAML override honored, else the repo's own agents.yaml, else
    ~/.claude/sable/agents.yaml). See bin/sable_registry_lib.py, the python
    mirror of hooks/multi-manager/lib-registry-path.sh (SABLE-59t6.1)."""
    return sable_registry_path()


# Exit code for the v1 fleet-boundary refusal (SABLE-59t6.4); distinct from the
# tool's other codes (1 no-session, 2 usage, 3 register-self, 4 collision).
FLEET_BOUNDARY_EXIT = 6


def fleet_boundary_refusal(base: str | None = None) -> str | None:
    """The v1 fleet-boundary remedy (FLEET_PROJECT_ONLY_REMEDY) when EVERY
    operation of this tool must refuse — the registry resolves to a PROJECT
    registry and no global install exists (SABLE-59t6.4) — else None. The whole
    tool is fleet tooling: it stands managers/producers up into the shared tmux
    session, which needs the global registry + dispatch dir a project-only
    install lacks. Scope detection is the 59t6.1 resolver's (fleet_project_only);
    bin/sable-launch enforces the identical boundary on its session door via the
    resolver's fleet-preflight CLI. The escape hatch (export SABLE_AGENTS_YAML)
    flips the scope to 'override' and lifts this."""
    return FLEET_PROJECT_ONLY_REMEDY if fleet_project_only(base) else None


def rollback_failed_pane(base: list[str], pane: str) -> str:
    """Remove an invocation-owned pane and report whether retry is unblocked."""
    subprocess.run(
        base + ["kill-pane", "-t", pane],
        capture_output=True, text=True,
    )
    listing = subprocess.run(
        base + ["list-panes", "-a", "-F", "#{pane_id}"],
        capture_output=True, text=True,
    )
    still_present = (
        listing.returncode == 0 and pane in listing.stdout.splitlines()
    )
    if still_present:
        return "WARNING: failed pane cleanup did not succeed"
    return "failed pane removed; retry can recreate the role"


def strip_instance_suffix(name: str) -> str:
    """Base registry name of a spawn-assigned instance (tarzan-2 -> tarzan).
    Diagnostic + write-time base lookup ONLY. Returns name unchanged when it
    carries no -<digits> suffix (tarzan, tarzan-abc, general-purpose)."""
    m = _INSTANCE_RE.match(name or "")
    return m.group("base") if m else (name or "")


def parse_registry(text: str) -> dict:
    """Minimal agents.yaml reader mirroring lib-identity's awk shape: a 2-space
    '<name>:' key under 'agents:', with 4-space 'type:' / 'instance_of:' beneath.
    No PyYAML dependency (matches the awk parser the hooks use)."""
    agents: dict = {}
    cur = None
    for raw in text.splitlines():
        m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", raw)
        if m:
            cur = m.group(1)
            agents[cur] = {}
            continue
        if cur is not None:
            mt = re.match(r"^    type:\s*([^\s#]+)", raw)
            if mt:
                agents[cur]["type"] = mt.group(1)
                continue
            mi = re.match(r"^    instance_of:\s*([^\s#]+)", raw)
            if mi:
                agents[cur]["instance_of"] = mi.group(1)
    return agents


def base_manager_type(text: str, name: str):
    """The registry type of <name>'s base entry, but only when <name> is an
    instance (<base>-<N>) AND <base> is a registered MANAGER. Else None."""
    base = strip_instance_suffix(name)
    if base == name:
        return None
    entry = parse_registry(text).get(base)
    if entry and entry.get("type") in MANAGER_TYPES:
        return entry["type"]
    return None


def register_instance(name: str, *, actor: str | None = None,
                      yaml_path: str | None = None) -> str:
    """Spawn-time writer (mechanism b): register instance <name> with its base
    manager's type, tagged instance_of:<base>, so lib-identity's UNCHANGED
    exact-match lookup resolves it as a manager. Idempotent. Returns a status:

      refused-self         actor == name — a session may not register ITSELF
                           (privilege comes from the operator/tooling-owned
                           registry; self-registration is self-elevation).
      noop-not-instance    <name> has no -<digits> suffix (not an instance)
      noop-no-registry     agents.yaml unreadable
      noop-base-not-manager  base is absent or not a manager type
      exists               <name> already registered (no change)
      registered           entry written
    """
    if actor is not None and actor == name:
        return "refused-self"
    base = strip_instance_suffix(name)
    if base == name:
        return "noop-not-instance"
    path = yaml_path or agents_yaml_path()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return "noop-no-registry"
    if name in parse_registry(text):
        return "exists"
    btype = base_manager_type(text, name)
    if not btype:
        return "noop-base-not-manager"
    entry = f"  {name}:\n    type: {btype}\n    instance_of: {base}\n"
    lines = text.splitlines(keepends=True)
    out, inserted = [], False
    for line in lines:
        out.append(line)
        if not inserted and re.match(r"^agents:\s*$", line):
            out.append(entry)          # first child of the agents: mapping
            inserted = True
    if not inserted:                    # no agents: root (unexpected) — seed one
        if out and not out[-1].endswith("\n"):
            out.append("\n")
        out.append("agents:\n" + entry)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("".join(out))
    return "registered"


def prune_stale_instances(live_names, *, yaml_path: str | None = None) -> list:
    """Remove instance entries (those carrying instance_of) whose key is NOT in
    live_names. Base / hand-authored entries (no instance_of) are never touched.
    Returns the pruned names. The prune path for reap / respawn."""
    path = yaml_path or agents_yaml_path()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return []
    live = set(live_names or [])
    reg = parse_registry(text)
    doomed = {n for n, e in reg.items() if "instance_of" in e and n not in live}
    if not doomed:
        return []
    lines = text.splitlines(keepends=True)
    out, pruned, i, n = [], [], 0, len(lines)
    while i < n:
        m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", lines[i])
        if m and m.group(1) in doomed:
            pruned.append(m.group(1))
            i += 1
            while i < n and re.match(r"^    \S", lines[i]):   # its type/instance_of body
                i += 1
            continue
        out.append(lines[i])
        i += 1
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("".join(out))
    return pruned


def tmux_base(socket: str | None) -> list[str]:
    return ["tmux", "-L", socket] if socket else ["tmux"]


def validate_roles(roles: list[str]) -> list[str]:
    bad = [r for r in roles if r not in ALL_ROLES]
    if bad:
        raise ValueError(f"invalid role(s) {', '.join(bad)} "
                         f"(valid: {', '.join(ALL_ROLES)})")
    return roles


def sable_class(role: str) -> str:
    """The @sable_class tag for a role (architecture.json decision 2): pane
    lifecycle classification lives here as an explicit tag rather than name-
    prefix parsing, so a future producer needs zero edits in the reaper."""
    return "producer" if role in PRODUCER_ROLES else "manager"


def missing_deliverable_error(requested: list[str], deliverable: str | None) -> str | None:
    """None when fine; else the hard-error message for a producer role
    requested without --deliverable (architecture.json decision 1: the
    contract requires an output path for every bounded producer pane)."""
    producer_requested = [r for r in requested if r in PRODUCER_ROLES]
    if producer_requested and not deliverable:
        return (f"--deliverable PATH required for producer role(s) "
                f"{', '.join(producer_requested)}")
    return None


def parse_existing_panes(output: str) -> dict[str, ExistingPane]:
    """Parse the session-scoped pane registry used by liveness planning.

    The seven tab-delimited fields are all event/state data.  Process age,
    scrollback, and pane-idle heuristics are intentionally absent because the
    measured cleared and working panes were indistinguishable on those axes.
    """
    panes: dict[str, ExistingPane] = {}
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) < 2 or not fields[1]:
            continue
        fields += [""] * (7 - len(fields))
        pane = ExistingPane(
            pane_id=fields[0],
            role=fields[1],
            provider=fields[2] or "claude",
            pane_dead=fields[3] == "1",
            status=fields[4],
            boot_epoch=fields[5],
            kicked_epoch=fields[6],
        )
        if pane.role in panes:
            raise ValueError(
                f"duplicate @sable_role={pane.role} in panes "
                f"{panes[pane.role].pane_id} and {pane.pane_id}"
            )
        panes[pane.role] = pane
    return panes


def classify_manager_pane(pane: ExistingPane) -> PaneLiveness:
    """Classify a manager from native death, lifecycle, and boot events only."""
    if pane.pane_dead or pane.status == "done":
        return PaneLiveness.DEAD
    if pane.status != "running" or not pane.boot_epoch or not pane.kicked_epoch:
        return PaneLiveness.UNKNOWN
    if pane.boot_epoch != pane.kicked_epoch:
        return PaneLiveness.RESTARTED_SINCE
    return PaneLiveness.ALIVE_AND_SESSIONED


def classify_producer_pane(pane: ExistingPane) -> PaneLiveness:
    """Bounded producers have lifecycle state but no SessionStart epoch."""
    if pane.pane_dead or pane.status == "done":
        return PaneLiveness.DEAD
    if pane.status == "running":
        return PaneLiveness.ALIVE_AND_SESSIONED
    return PaneLiveness.UNKNOWN


def provider_mismatches(
    requested: list[str],
    existing: dict[str, str],
    expected: dict[str, str],
) -> list[tuple[str, str, str]]:
    return [
        (role, existing[role], expected[role])
        for role in requested
        if role in existing and existing[role] != expected[role]
    ]


def plan_spawns(
    requested: list[str], existing: dict[str, ExistingPane]
) -> dict[str, SpawnAction]:
    """Turn liveness verdicts into distinct mutation plans.

    A running manager with a real boot epoch but no kick reference is the
    one-time upgrade seam.  It is adopted without typing: recording the current
    epoch makes subsequent changes detectable without risking a kick into a
    healthy mid-turn manager.
    """
    decisions: dict[str, SpawnAction] = {}
    for role in requested:
        pane = existing.get(role)
        if pane is None:
            decisions[role] = SpawnAction.SPAWN_NEW
            continue
        if (
            role not in PRODUCER_ROLES
            and not pane.pane_dead
            and pane.status == "running"
            and pane.boot_epoch
            and not pane.kicked_epoch
        ):
            decisions[role] = SpawnAction.ADOPT_REFERENCE
            continue
        liveness = (
            classify_producer_pane(pane)
            if role in PRODUCER_ROLES
            else classify_manager_pane(pane)
        )
        decisions[role] = {
            PaneLiveness.ALIVE_AND_SESSIONED: SpawnAction.SKIP_ALIVE,
            PaneLiveness.RESTARTED_SINCE: SpawnAction.REKICK_RESTARTED,
            PaneLiveness.DEAD: SpawnAction.RESPAWN_DEAD,
            PaneLiveness.UNKNOWN: SpawnAction.REFUSE_UNKNOWN,
        }[liveness]
    return decisions


def stabilize_manager_kick(
    *,
    ready: Callable[[], bool],
    read_epoch: Callable[[], str],
    deliver: Callable[[str], bool],
    record: Callable[[str], bool],
    attempts: int,
) -> tuple[bool, str]:
    """Deliver under one stable boot epoch and publish its kick reference.

    Readiness may span a concurrent clear, so the epoch is read only after the
    readiness check and immediately before delivery.  A changed post-delivery
    epoch causes a bounded re-kick; the reference is committed only after two
    equal reads and verified delivery.
    """
    for _ in range(max(1, attempts)):
        if not ready():
            return False, "pane-not-ready"
        before = read_epoch()
        if not before:
            return False, "missing-agent-boot-epoch"
        if not deliver(before):
            return False, "delivery-unverified"
        after = read_epoch()
        if not after:
            return False, "missing-agent-boot-epoch-after-delivery"
        if after != before:
            continue
        if not record(after):
            return False, "kick-reference-write-failed"
        return True, after
    return False, "boot-epoch-changed-during-every-delivery-attempt"


def manager_command(provider: str = "claude", cwd: str | None = None) -> str:
    """The command used to launch a manager pane. Managers ALWAYS run on Opus
    (SABLE-gbd) — the per-bead model ladder (SABLE.md 6.9) governs the workers
    a manager dispatches, never the manager's own model. SABLE_TMUX_PANE_CMD is
    a full override for tests only and is exempt from the pin."""
    override = os.environ.get("SABLE_TMUX_PANE_CMD")
    if override:
        return override
    perm = os.environ.get("SABLE_WORKER_PERMISSION", "--permission-mode bypassPermissions")
    add_dirs = [str(Path(cwd).parent)] if provider == "codex" and cwd else []
    # Codex's workspace-write sandbox blocks .git even inside the workspace, so
    # a seat cannot fetch and a worker cannot push without naming it. The grant
    # is the SHARED git dir, never <cwd>/.git — see git_common_dir (SABLE-82k8m).
    roots = []
    if provider == "codex" and cwd:
        common = git_common_dir(cwd)
        if common:
            roots = [common]
    return interactive_command(
        provider, "opus", claude_permission=perm, cwd=cwd, add_dirs=add_dirs,
        writable_roots=roots,
    )


def producer_command(
    model: str, provider: str = "claude", cwd: str | None = None
) -> str:
    """A producer's command line pins its CALLER-CHOSEN model tier
    (architecture.json decision 1) — unlike manager_command, which always
    pins Opus regardless of any tier argument (SABLE-gbd: the model ladder
    is for bounded producers and workers, never for the always-on manager
    fleet)."""
    override = os.environ.get("SABLE_TMUX_PANE_CMD")
    if override:
        return override
    perm = os.environ.get("SABLE_WORKER_PERMISSION", "--permission-mode bypassPermissions")
    return interactive_command(
        provider, model, claude_permission=perm, cwd=cwd,
    )


def window_args(
    session: str, role: str, cmd: str, provider: str = "claude"
) -> list[str]:
    """A DETACHED named window (-d): the operator's current window is never
    stolen. Managers/producers are windows, not splits. Producer roles get
    CLAUDE_AGENT_ROLE=producer; managers keep CLAUDE_AGENT_ROLE=manager
    byte-identical to before (regression-locked)."""
    agent_role = "producer" if role in PRODUCER_ROLES else "manager"
    env_args: list[str] = []
    for key, value in pane_environment(provider, role, agent_role).items():
        env_args += ["-e", f"{key}={value}"]
    return [
        "new-window", "-d", "-t", session, "-n", role,
        "-P", "-F", "#{pane_id}", *env_args, cmd,
    ]


def respawn_args(
    pane: str, role: str, cmd: str, provider: str = "claude"
) -> list[str]:
    """Replace a dead role in place, preserving its tmux pane identity."""
    agent_role = "producer" if role in PRODUCER_ROLES else "manager"
    env_args: list[str] = []
    for key, value in pane_environment(provider, role, agent_role).items():
        env_args += ["-e", f"{key}={value}"]
    return ["respawn-pane", "-k", "-t", pane, *env_args, cmd]


def pane_option(base: list[str], pane: str, name: str) -> str:
    result = subprocess.run(
        base + ["show-options", "-p", "-v", "-t", pane, name],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def write_pane_option(base: list[str], pane: str, name: str, value: str) -> bool:
    return subprocess.run(
        base + ["set-option", "-p", "-t", pane, name, value],
        capture_output=True,
        text=True,
    ).returncode == 0


def clear_pane_option(base: list[str], pane: str, name: str) -> bool:
    return subprocess.run(
        base + ["set-option", "-p", "-u", "-t", pane, name],
        capture_output=True,
        text=True,
    ).returncode == 0


def unknown_liveness_reason(role: str, pane: ExistingPane) -> str:
    missing: list[str] = []
    if not pane.status:
        missing.append("@sable_status")
    elif pane.status not in ("running", "done"):
        missing.append(f"recognized @sable_status (got {pane.status!r})")
    if role not in PRODUCER_ROLES and not pane.boot_epoch:
        missing.append("agent-written @sable_boot_epoch")
    if role not in PRODUCER_ROLES and pane.boot_epoch and not pane.kicked_epoch:
        missing.append("@sable_kicked_epoch")
    return ", ".join(missing) or "incomplete liveness evidence"


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="sable-spawn-manager")
    p.add_argument("roles", nargs="*", help=f"roles to spawn ({' | '.join(ALL_ROLES)})")
    p.add_argument("--all", action="store_true", help="spawn all three managers")
    p.add_argument("--deliverable", metavar="PATH",
                   help="output path for a producer role's deliverable "
                        "(required for producer roles, e.g. victor)")
    p.add_argument("--model", metavar="TIER",
                   help="model tier for a producer role's pane (default: "
                        f"{DEFAULT_PRODUCER_MODEL})")
    p.add_argument("--register-instance", metavar="NAME",
                   help="register a spawn-assigned manager instance (e.g. tarzan-2) "
                        "into agents.yaml so lib-identity resolves it as a manager "
                        "(mechanism b; a running session may not register itself)")
    p.add_argument("--prune-instances", action="store_true",
                   help="prune stale instance entries whose panes are no longer live")
    ns = p.parse_args(sys.argv[1:] if argv is None else argv)

    # --- v1 fleet boundary (SABLE-59t6.4): refuse EVERY sable-spawn-manager
    # operation under a project-only install (project registry, no global
    # install, no SABLE_AGENTS_YAML override). This tool only ever stands panes
    # up into the shared fleet session; none of it works without the global
    # machinery. Solo-loop paths (Lincoln, producer SUBAGENTS, planning) never
    # reach this tool, so no non-fleet path is gated here.
    remedy = fleet_boundary_refusal()
    if remedy:
        sys.stderr.write(f"sable-spawn-manager: {remedy}\n")
        return FLEET_BOUNDARY_EXIT

    # --- Instance registry maintenance (73t4). These are the spawn/respawn
    # tooling entry points into the writer; they never spawn a pane.
    if ns.register_instance:
        actor = (os.environ.get("SABLE_REGISTER_ACTOR")
                 or os.environ.get("CLAUDE_AGENT_NAME") or "") or None
        status = register_instance(ns.register_instance, actor=actor)
        sys.stderr.write(
            f"sable-spawn-manager: register-instance {ns.register_instance}: {status}\n")
        return 3 if status == "refused-self" else 0

    socket = os.environ.get("SABLE_TMUX_SOCKET") or None
    base = tmux_base(socket)
    try:
        session = resolve_session(socket=socket)
    except SessionCollision as e:
        sys.stderr.write(f"sable-spawn-manager: {e}\n")
        return 4

    if ns.prune_instances:
        # session-scoped (SABLE-e1e3): another repo's live roles must not keep
        # THIS repo's stale registry entries alive
        listing = subprocess.run(base + ["list-panes", "-s", "-t", session,
                                         "-F", "#{@sable_role}"],
                                 capture_output=True, text=True)
        live = {r for r in listing.stdout.split() if r} if listing.returncode == 0 else set()
        pruned = prune_stale_instances(live)
        sys.stderr.write(
            f"sable-spawn-manager: pruned {len(pruned)} stale instance "
            f"entr{'y' if len(pruned) == 1 else 'ies'}"
            f"{': ' + ', '.join(pruned) if pruned else ''}\n")
        return 0

    requested = list(VALID_ROLES) if ns.all else ns.roles
    if not requested:
        p.print_help(sys.stderr)
        return 2
    try:
        validate_roles(requested)
    except ValueError as e:
        sys.stderr.write(f"sable-spawn-manager: {e}\n")
        return 2

    deliverable_err = missing_deliverable_error(requested, ns.deliverable)
    if deliverable_err:
        sys.stderr.write(f"sable-spawn-manager: {deliverable_err}\n")
        return 2

    root = repo_root()
    if any(role not in PRODUCER_ROLES for role in requested):
        try:
            read_execution_authority(base=root)
        except HandoffRefused as e:
            sys.stderr.write(
                "sable-spawn-manager: execution handoff refused before fleet "
                f"start: {e}\n"
            )
            return 5

    if subprocess.run(base + ["has-session", "-t", session],
                      capture_output=True).returncode != 0:
        sys.stderr.write(f"sable-spawn-manager: no '{session}' session — "
                         f"start one with: sable-launch\n")
        return 1

    provider_by_role: dict[str, str] = {}
    for role in requested:
        if role in PRODUCER_ROLES:
            provider_by_role[role] = DEFAULT_PROVIDER
        else:
            try:
                provider_by_role[role] = execution_provider(
                    strip_instance_suffix(role), base=root
                )
            except ProviderMapError as e:
                sys.stderr.write(f"sable-spawn-manager: {e}\n")
                return 5

    listing_result = subprocess.run(
        base + [
            "list-panes", "-s", "-t", session, "-F",
            ("#{pane_id}\t#{@sable_role}\t#{@sable_provider}\t#{pane_dead}\t"
             "#{@sable_status}\t#{@sable_boot_epoch}\t#{@sable_kicked_epoch}"),
        ],
        capture_output=True,
        text=True,
    )
    if listing_result.returncode != 0:
        detail = listing_result.stderr.strip() or f"exit {listing_result.returncode}"
        sys.stderr.write(
            "sable-spawn-manager: UNKNOWN liveness precondition — session pane "
            f"registry could not be read ({detail}); refusing without mutation.\n"
        )
        return 12
    try:
        existing = parse_existing_panes(listing_result.stdout)
    except ValueError as e:
        sys.stderr.write(
            "sable-spawn-manager: UNKNOWN liveness precondition — ambiguous "
            f"session pane registry ({e}); refusing without mutation.\n"
        )
        return 12
    decisions = plan_spawns(requested, existing)

    unknown = [
        role for role in requested
        if decisions[role] is SpawnAction.REFUSE_UNKNOWN
    ]
    if unknown:
        details = "; ".join(
            f"role={role} pane={existing[role].pane_id} missing="
            f"{unknown_liveness_reason(role, existing[role])}"
            for role in unknown
        )
        sys.stderr.write(
            "sable-spawn-manager: UNKNOWN liveness precondition — refusing "
            f"without kick, kill, or spawn: {details}. A bare role tag is not "
            "proof of a live agent; start the pane through sable-spawn-manager "
            "or restore its SessionStart/lifecycle hooks. For a live "
            "pre-migration manager with no lifecycle status, deliberately stop "
            "that pane so tmux reports pane_dead=1, then rerun; UNKNOWN is never "
            "killed automatically.\n"
        )
        return 12

    retained_providers = {
        role: pane.provider
        for role, pane in existing.items()
        if decisions.get(role) is not SpawnAction.RESPAWN_DEAD
    }
    mismatches = provider_mismatches(
        requested, retained_providers, provider_by_role
    )
    if mismatches:
        detail = ", ".join(
            f"{role} is {actual}, execution requires {wanted}"
            for role, actual, wanted in mismatches
        )
        sys.stderr.write(
            "sable-spawn-manager: refusing stale provider pane(s): "
            f"{detail}. Stand down/reap those panes before relaunch.\n"
        )
        return 5
    starts_process = {SpawnAction.SPAWN_NEW, SpawnAction.RESPAWN_DEAD}
    if any(
        provider_by_role[role] == "codex" and decisions[role] in starts_process
        for role in requested
    ):
        try:
            validate_codex_hook_graph()
        except ProviderMapError as e:
            sys.stderr.write(
                f"sable-spawn-manager: refusing Codex pane spawn: {e}\n"
            )
            return 5
    for role in requested:
        action = decisions[role]
        if action is SpawnAction.SKIP_ALIVE:
            sys.stderr.write(
                f"sable-spawn-manager: {role} ALIVE-AND-SESSIONED in "
                f"pane={existing[role].pane_id} — skipping\n"
            )
        elif action is SpawnAction.ADOPT_REFERENCE:
            pane = existing[role]
            if not write_pane_option(
                base, pane.pane_id, "@sable_kicked_epoch", pane.boot_epoch
            ):
                sys.stderr.write(
                    "sable-spawn-manager: UNKNOWN liveness precondition — "
                    f"could not adopt role={role} pane={pane.pane_id}; no kick "
                    "or kill attempted.\n"
                )
                return 12
            sys.stderr.write(
                f"sable-spawn-manager: ADOPTED role={role} pane={pane.pane_id} "
                f"at epoch={pane.boot_epoch} without typing or killing\n"
            )

    ready_timeout = float(os.environ.get("SABLE_DISPATCH_READY_TIMEOUT", "25"))
    submit_tries = int(os.environ.get("SABLE_DISPATCH_SUBMIT_TRIES", "8"))
    poll_interval = float(os.environ.get("SABLE_DISPATCH_POLL_INTERVAL", "1.0"))
    epoch_tries = int(os.environ.get("SABLE_MANAGER_REKICK_TRIES", "3"))
    producer_model = ns.model or DEFAULT_PRODUCER_MODEL

    for role in requested:
        action = decisions[role]
        if action in (SpawnAction.SKIP_ALIVE, SpawnAction.ADOPT_REFERENCE):
            continue
        is_producer = role in PRODUCER_ROLES
        provider = provider_by_role[role]
        invocation_owned = action in starts_process

        if action is SpawnAction.REKICK_RESTARTED:
            pane = existing[role].pane_id
        else:
            raw_cmd = (
                producer_command(producer_model, provider, root)
                if is_producer
                else manager_command(provider, root)
            )
            cmd = with_lifecycle_flags(raw_cmd)
            if action is SpawnAction.RESPAWN_DEAD:
                pane = existing[role].pane_id
                for option in (
                    "@sable_status",
                    "@sable_boot_agent",
                    "@sable_boot_epoch",
                    "@sable_kicked_epoch",
                ):
                    if not clear_pane_option(base, pane, option):
                        sys.stderr.write(
                            "sable-spawn-manager: refused respawn for "
                            f"role={role} pane={pane}: could not clear stale "
                            f"{option}.\n"
                        )
                        return 12
                subprocess.run(
                    base + respawn_args(pane, role, cmd, provider),
                    capture_output=True,
                    text=True,
                    check=True,
                )
            else:
                pane = subprocess.run(
                    base + window_args(session, role, cmd, provider),
                    capture_output=True,
                    text=True,
                    check=True,
                ).stdout.strip()

            for option, value in (
                ("@sable_role", role),
                ("@sable_provider", provider),
                ("@sable_class", sable_class(role)),
            ):
                if not write_pane_option(base, pane, option, value):
                    cleanup = rollback_failed_pane(base, pane)
                    sys.stderr.write(
                        "sable-spawn-manager: REFUSING bootstrap "
                        f"role={role} pane={pane}: could not stamp {option}; "
                        f"{cleanup}.\n"
                    )
                    return 12
            if is_producer and not write_pane_option(
                base, pane, "@sable_deliverable", ns.deliverable or ""
            ):
                cleanup = rollback_failed_pane(base, pane)
                sys.stderr.write(
                    "sable-spawn-manager: REFUSING producer bootstrap "
                    f"role={role} pane={pane}: deliverable tag failed; {cleanup}.\n"
                )
                return 12
            if root and not write_pane_option(base, pane, "@sable_repo", root):
                cleanup = rollback_failed_pane(base, pane)
                sys.stderr.write(
                    "sable-spawn-manager: REFUSING bootstrap "
                    f"role={role} pane={pane}: repo tag failed; {cleanup}.\n"
                )
                return 12

            assigned = subprocess.run(
                base + ["display-message", "-p", "-t", pane, "#{@sable_role}"],
                capture_output=True,
                text=True,
            ).stdout.strip() or role
            register_instance(
                assigned,
                actor=(
                    os.environ.get("SABLE_AGENT_NAME")
                    or os.environ.get("CLAUDE_AGENT_NAME")
                ),
            )

        kick = kick_message(role, deliverable=ns.deliverable if is_producer else None)
        if not is_producer:
            try:
                kick = provider_boot_message(provider, role, kick, base=root)
            except ProviderMapError as e:
                cleanup = (
                    rollback_failed_pane(base, pane)
                    if invocation_owned
                    else "existing restarted pane left untouched"
                )
                sys.stderr.write(
                    "sable-spawn-manager: REFUSING bootstrap "
                    f"role={role} pane={pane} provider={provider}: {e}; "
                    f"{cleanup}.\n"
                )
                return 5

        def pane_ready_now() -> bool:
            return ready_timeout <= 0 or wait_for_ready(
                base, pane, ready_timeout, interval=poll_interval,
                provider=provider,
            )

        if is_producer:
            if not pane_ready_now():
                cap = capture_pane(base, pane)
                state = (
                    "interactive dialog/selector"
                    if dialog_posture(cap)
                    else "not in composer posture (still booting, exited, or stuck)"
                )
                cleanup = rollback_failed_pane(base, pane)
                sys.stderr.write(
                    "sable-spawn-manager: REFUSING bootstrap "
                    f"role={role} pane={pane} provider={provider} state={state}; "
                    f"producer kick was NOT typed; {cleanup}.\n"
                )
                return 10
            if not deliver_text(
                base, pane, kick, KICK_TAG, tries=submit_tries,
                interval=poll_interval, provider=provider,
            ):
                cleanup = rollback_failed_pane(base, pane)
                sys.stderr.write(
                    "sable-spawn-manager: REFUSING bootstrap "
                    f"role={role} pane={pane} provider={provider}: delivery "
                    f"could not be verified; {cleanup}.\n"
                )
                return 11
            verb = "respawned" if action is SpawnAction.RESPAWN_DEAD else "up"
            sys.stderr.write(
                f"sable-spawn-manager: {role} {verb} in pane={pane}, kicked "
                "into its bounded producer run\n"
            )
            continue

        stable, detail = stabilize_manager_kick(
            ready=pane_ready_now,
            read_epoch=lambda: pane_option(base, pane, "@sable_boot_epoch"),
            deliver=lambda _epoch: deliver_text(
                base, pane, kick, KICK_TAG, tries=submit_tries,
                interval=poll_interval, provider=provider,
            ),
            record=lambda epoch: write_pane_option(
                base, pane, "@sable_kicked_epoch", epoch
            ),
            attempts=epoch_tries,
        )
        if not stable:
            diagnostic = (
                "delivery could not be verified"
                if detail == "delivery-unverified"
                else detail
            )
            if detail == "pane-not-ready":
                cap = capture_pane(base, pane)
                state = (
                    "interactive dialog/selector"
                    if dialog_posture(cap)
                    else "not in composer posture (still booting, exited, or stuck)"
                )
                diagnostic = f"{detail}; state={state}; kick was NOT typed"
            cleanup = (
                rollback_failed_pane(base, pane)
                if invocation_owned
                else "existing restarted pane left untouched"
            )
            exit_code = (
                10 if detail == "pane-not-ready"
                else 11 if detail == "delivery-unverified"
                else 12
            )
            sys.stderr.write(
                "sable-spawn-manager: REFUSING bootstrap "
                f"role={role} pane={pane} provider={provider}: {diagnostic}; "
                f"kick reference NOT published; {cleanup}.\n"
            )
            return exit_code

        if action is SpawnAction.REKICK_RESTARTED:
            sys.stderr.write(
                f"sable-spawn-manager: RESTARTED-SINCE detected for role={role} "
                f"pane={pane}; re-kicked operating loop at epoch={detail}\n"
            )
        elif action is SpawnAction.RESPAWN_DEAD:
            sys.stderr.write(
                f"sable-spawn-manager: DEAD role={role} respawned in same "
                f"pane={pane}; kicked at epoch={detail}\n"
            )
        else:
            sys.stderr.write(
                f"sable-spawn-manager: {role} up in pane={pane}, kicked into "
                f"its operating loop at epoch={detail}\n"
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())
