#!/usr/bin/env python3
"""sable-tmux — lay out a SABLE warm-pane session (SABLE-bldh.2).

One command stands up the tmux session the operator drives: one persistent
interactive pane per role (lincoln, optimus, tarzan, chuck), each with its
provider-neutral identity set and registered for the messaging/worker tools
(@sable_role pane user-option). Replaces opening N terminals by hand.

  lincoln  — the cockpit pane you talk to
  optimus  — epic manager      } resident managers; they spawn worker windows
  tarzan   — one-off manager   } via sable-spawn-worker
  chuck    — merge queue

Usage:
  sable-tmux [--session NAME] [--roles lincoln,optimus,tarzan,chuck] [--attach]

Env:
  SABLE_TMUX_SOCKET     tmux socket (-L) for isolation/tests
  SABLE_TMUX_PANE_CMD   per-pane command (default: 'claude'); override for tests

After it runs, attach with:  tmux attach -t <session>
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

# Shared pane-readiness/dispatch helpers (SABLE-bldh.14) + the autonomous-role
# kick logic (SABLE-dqhn.2 — shared with sable-spawn-manager). Resolve the lib
# next to THIS script even when invoked via a PATH symlink.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from sable_pane_lib import (  # noqa: E402
    AUTONOMOUS_ROLES, KICK_TAG, SessionCollision, deliver_text, kick_message,
    repo_root, resolve_session, wait_for_ready,
)
from sable_provider_lib import (  # noqa: E402
    ProviderMapError, execution_provider_map, interactive_command, pane_environment,
    provider_boot_message,
)

DEFAULT_ROLES = ["lincoln", "optimus", "tarzan", "chuck"]


def parse_roles(arg: str | None) -> list[str]:
    if not arg:
        return list(DEFAULT_ROLES)
    return [r.strip() for r in arg.split(",") if r.strip()]


def pane_env_args(role: str, provider: str = "claude") -> list[str]:
    args: list[str] = []
    for key, value in pane_environment(provider, role, "manager").items():
        args += ["-e", f"{key}={value}"]
    return args


def pane_command(
    role: str, autostart: bool, provider: str = "claude",
    cwd: str | None = None,
) -> str:
    """Stand-in override wins verbatim (tests). Otherwise `claude`, plus a bypass
    permission posture for the autonomous roles under --autostart so they can run
    sable-spawn-worker / git merge without prompting (SABLE-bldh.14 / .12)."""
    override = os.environ.get("SABLE_TMUX_PANE_CMD")
    if override:
        return override
    if provider == "claude":
        cmd = "claude"
        if autostart and role in AUTONOMOUS_ROLES:
            permission = os.environ.get(
                "SABLE_WORKER_PERMISSION", "--permission-mode bypassPermissions"
            )
            cmd = f"{cmd} {permission}"
        return cmd
    tier = "opus" if role in AUTONOMOUS_ROLES else "sonnet"
    add_dirs = [str(Path(cwd).parent)] if role in AUTONOMOUS_ROLES and cwd else []
    return interactive_command(
        provider, tier, cwd=cwd, add_dirs=add_dirs,
    )


def tmux_base(socket: str | None) -> list[str]:
    return ["tmux", "-L", socket] if socket else ["tmux"]


def _run(args: list[str]) -> str:
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def _tag(base, pane, role, root=None, provider="claude"):
    subprocess.run(base + ["set-option", "-p", "-t", pane, "@sable_role", role], check=True)
    subprocess.run(
        base + ["set-option", "-p", "-t", pane, "@sable_provider", provider],
        check=True,
    )
    if root:
        subprocess.run(base + ["set-option", "-p", "-t", pane, "@sable_repo", root], check=True)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="sable-tmux")
    p.add_argument("--session", help="target session (default: SABLE_TMUX_SESSION, "
                                     "else derived per-repo — see sable-session)")
    p.add_argument("--roles", help="comma-separated role list (default: all four)")
    p.add_argument("--attach", action="store_true", help="attach after layout")
    p.add_argument("--autostart", action="store_true",
                   help="launch the autonomous roles (optimus/tarzan/chuck) with a "
                        "bypass posture and kick them into their operating loops")
    ns = p.parse_args(sys.argv[1:] if argv is None else argv)

    roles = parse_roles(ns.roles)
    if not roles:
        sys.stderr.write("sable-tmux: no roles\n")
        return 2
    socket = os.environ.get("SABLE_TMUX_SOCKET") or None
    base = tmux_base(socket)
    root = repo_root()
    try:
        execution_providers = execution_provider_map(base=root)
    except ProviderMapError as e:
        sys.stderr.write(f"sable-tmux: refusing invalid provider state: {e}\n")
        return 5
    providers: dict[str, str] = {}
    for role in roles:
        if role not in AUTONOMOUS_ROLES:
            providers[role] = "claude"
            continue
        providers[role] = (
            execution_providers[role] if execution_providers else "claude"
        )
    if ns.session:
        sess = ns.session
    else:
        try:
            sess = resolve_session(socket=socket)
        except SessionCollision as e:
            sys.stderr.write(f"sable-tmux: {e}\n")
            return 4

    # refuse to clobber an existing session
    if subprocess.run(base + ["has-session", "-t", sess],
                      capture_output=True).returncode == 0:
        sys.stderr.write(f"sable-tmux: session '{sess}' already exists "
                         f"(attach with: tmux attach -t {sess})\n")
        return 1

    # first role -> new session; rest -> tiled splits
    panes: dict[str, str] = {}
    first = roles[0]
    pane = _run(base + ["new-session", "-d", "-s", sess, "-x", "220", "-y", "55",
                        "-P", "-F", "#{pane_id}",
                        *pane_env_args(first, providers[first]),
                        pane_command(
                            first, ns.autostart, providers[first], root
                        )]).strip()
    if root:
        # the collision guard other repos' resolvers check (SABLE-e1e3)
        subprocess.run(base + ["set-option", "-t", sess, "@sable_repo", root],
                       check=True)
    _tag(base, pane, first, root, providers[first])
    panes[first] = pane
    for role in roles[1:]:
        pane = _run(base + ["split-window", "-t", sess, "-P", "-F", "#{pane_id}",
                            *pane_env_args(role, providers[role]),
                            pane_command(
                                role, ns.autostart, providers[role], root
                            )]).strip()
        _tag(base, pane, role, root, providers[role])
        panes[role] = pane
        subprocess.run(base + ["select-layout", "-t", sess, "tiled"], check=True)

    sys.stderr.write(f"sable-tmux: session '{sess}' up with roles: {', '.join(roles)}\n")

    # --autostart: kick the autonomous roles into their operating loops once their
    # TUIs are ready (wait_for_ready also accepts the bypass-permissions gate).
    if ns.autostart:
        ready_timeout = float(os.environ.get("SABLE_DISPATCH_READY_TIMEOUT", "25"))
        submit_tries = int(os.environ.get("SABLE_DISPATCH_SUBMIT_TRIES", "8"))
        poll_interval = float(os.environ.get("SABLE_DISPATCH_POLL_INTERVAL", "1.0"))
        for role in roles:
            if role not in AUTONOMOUS_ROLES:
                continue
            kpane = panes[role]
            provider = providers[role]
            if ready_timeout > 0:
                wait_for_ready(
                    base, kpane, ready_timeout, interval=poll_interval,
                    provider=provider,
                )
            kick = provider_boot_message(
                provider, role, kick_message(role), base=root
            )
            if deliver_text(
                base, kpane, kick, KICK_TAG, tries=submit_tries,
                interval=poll_interval, provider=provider,
            ):
                sys.stderr.write(f"sable-tmux: kicked {role} into its operating loop\n")
            else:
                sys.stderr.write(f"sable-tmux: WARNING kick to {role} ({kpane}) "
                                 f"may be unsubmitted\n")

    sys.stderr.write(f"  attach: tmux{' -L ' + socket if socket else ''} attach -t {sess}\n")
    if ns.attach:
        os.execvp("tmux", base[0:1] + base[1:] + ["attach", "-t", sess])
    return 0


if __name__ == "__main__":
    sys.exit(main())
