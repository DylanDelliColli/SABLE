# --------------------------------------------------------------------------
# Pure predicates (unit-tested directly — no git/bd required)
# --------------------------------------------------------------------------

def is_wk_branch(branch: str) -> bool:
    """Worker branches are `wk-*`. Only these are candidates — a manager's own
    push or the integration branch itself is never reconciled here."""
    return branch.startswith("wk-")


def ancestor_rc_is_unmerged(rc: int) -> bool:
    """Predicate 1. `git merge-base --is-ancestor <branch> <base>` exits 0 when
    the branch IS an ancestor (already merged) and 1 when it is NOT (unmerged).
    Only a clean rc==1 counts as unmerged — any other code (128 on a bad ref,
    etc.) is an UNRESOLVED classification, so we conservatively treat the branch
    as not-stranded rather than invent merge work off a git error."""
    return rc == 1


# --------------------------------------------------------------------------
# CONTAINMENT VOCABULARY (SABLE-rhsuj / SABLE-q0e3n) — three values, never two.
#
# The whole point of this bead pair is that a retirement decision must be keyed
# on the CONTENT BEING PRESENT at the spine, and that a probe which could not
# run is its OWN answer. Two-valued containment is how "I could not look there"
# renders identically to "it is not there" (SABLE-8b41.8: a `merge-base
# --is-ancestor` against a retired ref errored, the `||` fired, and a correct
# merge was reported NOT CONTAINED). Both wrong directions are reachable from a
# two-valued probe and only one of them is cheap.
# --------------------------------------------------------------------------

CONTAINED = "contained"
NOT_CONTAINED = "not-contained"
CONTAINMENT_UNASSESSABLE = "could-not-assess"


def containment_verdict_from_rc(rc: int) -> str:
    """`git merge-base --is-ancestor <sha> <base>` exit code -> verdict.

    0 = <sha> IS reachable from <base>: CONTAINED (the presence answer, and the
    ONLY rc that may retire anything). 1 = it is NOT: NOT_CONTAINED. Anything
    else (128 on a missing ref/object, 127 on a broken git) is
    CONTAINMENT_UNASSESSABLE — never silently folded into either verdict.

    Same vocabulary and same rc mapping as bin/sable-contained's
    is_ancestor_verdict, so 'has this landed' has ONE answer shape fleet-wide."""
    if rc == 0:
        return CONTAINED
    if rc == 1:
        return NOT_CONTAINED
    return CONTAINMENT_UNASSESSABLE


def work_bead_qualifies(status: str | None) -> bool:
    """Predicate 2. The branch's work bead must be closed (work finished) or
    in_progress (a landed-mid-flight worker) to count as real merge work. An
    absent bead (None), an open/blocked/deferred bead, or anything else does not
    qualify — the branch may be an abandoned experiment, and this floor never
    invents merge work no worker actually completed."""
    return status in ("closed", "in_progress")


def title_names_branch(title: str | None, branch: str) -> bool:
    """Predicate 3's core: does a `for-chuck` bead TITLE name this exact branch?
    Matched on a delimited-token boundary so `wk-foo` in a title does NOT match a
    bead about `wk-foobar` (branch chars are alnum plus - . / _). This is the
    idempotency key — our own filed title carries the branch, so a re-run sees it
    here and skips a duplicate."""
    if not title:
        return False
    pat = r"(?:^|[^\w./-])" + re.escape(branch) + r"(?:$|[^\w./-])"
    return re.search(pat, title) is not None


def branch_named_by_open_for_chuck(open_beads: list[dict] | None, branch: str) -> bool:
    """Predicate 3. True iff any open/in-progress `for-chuck` bead's title names
    the branch (a hook-filed handoff OR a prior reconciliation).

    open_beads is None when open_for_chuck_beads' query FAILED (corpus
    unknown, not legitimately empty) — treated as True (assume-named) so a
    transient bd failure suppresses filing rather than risking a duplicate.
    The conservative direction is deliberately the OPPOSITE of
    find_work_bead_status's metadata-query failure elsewhere in this file:
    there, an empty result would wrongly leave a branch un-strandable, so the
    safe fallback is to warn and keep going; here, an empty result IS the
    suppression signal reconcile() acts on, so the safe fallback is to
    assume-suppressed and skip this cadence."""
    if open_beads is None:
        return True
    return any(title_names_branch(b.get("title"), branch) for b in open_beads)


def age_exceeds_threshold(age_seconds: float, threshold_minutes: float) -> bool:
    """Predicate 4. Strict `>`: a branch AT the threshold is still inside the
    settle window and is left for the next sweep (mirrors is_orphan's strict-`>`
    in sable-merge-gate so the boundary is unambiguous)."""
    return age_seconds > threshold_minutes * 60.0


def preview_kick_eligible(rc: int, age_seconds: float | None,
                          threshold_minutes: float) -> tuple[bool, str]:
    """S5 poll-leg kick decision (SABLE-jd5fj.2): is this branch a candidate for
    a MISSED preview kick? Reuses predicate 1 (`ancestor_rc_is_unmerged`) and
    predicate 4 (`age_exceeds_threshold`) — the SAME pure checks the stranded
    predicate uses — but deliberately skips predicates 2/3 (work-bead status,
    for-chuck handoff already filed): a preview kick is a speculative CI
    warm-up, not a merge handoff, so it is eligible even for a branch with no
    work bead yet or one whose handoff bead already exists. Double-kick safety
    is NOT decided here — see `attempt_preview_kick`. Returns (eligible, reason)
    for the print trail, mirroring `classify_branch`'s shape."""
    if not ancestor_rc_is_unmerged(rc):
        return (False, f"merged-or-unresolvable(is-ancestor rc={rc})")
    if age_seconds is None:
        return (False, "age-unresolvable")
    if not age_exceeds_threshold(age_seconds, threshold_minutes):
        return (False, f"too-fresh({age_seconds:.0f}s <= {threshold_minutes}min settle)")
    return (True, "eligible-for-preview-kick")


# --------------------------------------------------------------------------
# HOLD: the first-class third outcome (SABLE-jejx3). Pure functions only — the
# hold lives in the WORK BEAD's metadata (see module docstring), so everything
# below operates on an already-fetched bead record and is unit-testable with no
# bd/git at all.
# --------------------------------------------------------------------------

HOLD_REASON_KEY = "hold"
HOLD_BY_KEY = "hold_by"
HOLD_SINCE_KEY = "hold_since"
HOLD_UNTIL_KEY = "hold_until"

# Sentinel for "the work bead could not be READ, so hold state is unknown".
# Deliberately NOT None (which means 'read fine, not held') — collapsing the two
# is exactly the mistake that files an inverted 'merge me' handoff for a branch
# that is in fact under a do-not-merge hold.
HOLD_UNKNOWN = "hold-state-unknown"

DEFAULT_HOLD_STALE_DAYS = 3.0


def hold_from_bead(bead: dict | None) -> dict | None:
    """The hold record carried by a work bead, or None when the bead is not
    held. Presence is keyed on a NON-EMPTY `hold` metadata value (the reason) —
    the other three fields are detail, and their ABSENCE is reported as a review
    flag rather than treated as a missing hold, so a sloppily-placed hold still
    protects the branch while being loudly incomplete."""
    if not isinstance(bead, dict):
        return None
    meta = bead.get("metadata")
    if not isinstance(meta, dict):
        return None
    reason = meta.get(HOLD_REASON_KEY)
    if not isinstance(reason, str) or not reason.strip():
        return None
    def _field(key: str) -> str | None:
        v = meta.get(key)
        return v.strip() if isinstance(v, str) and v.strip() else None
    return {
        "bead": bead.get("id"),
        "reason": reason.strip(),
        "by": _field(HOLD_BY_KEY),
        "since": _field(HOLD_SINCE_KEY),
        "until": _field(HOLD_UNTIL_KEY),
    }


def parse_hold_since(since: str | None) -> float | None:
    """Epoch seconds for an ISO8601 `hold_since` (a trailing `Z` is accepted —
    it is what bd and every SABLE timestamp writer emit). None when absent or
    unparseable; an unparseable date is treated the same as a missing one, i.e.
    the hold's age is UNKNOWN and that fact is flagged, never assumed fresh."""
    if not since:
        return None
    text = since.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        from datetime import datetime
        dt = datetime.fromisoformat(text)
    except (ValueError, TypeError):
        return None
    if dt.tzinfo is None:
        from datetime import timezone
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.timestamp()


def hold_age_days(hold: dict, now: float) -> float | None:
    """Age of the hold in days, or None when `hold_since` is missing/unparseable."""
    ts = parse_hold_since(hold.get("since"))
    if ts is None:
        return None
    return max(0.0, (now - ts) / 86400.0)


def hold_review_flags(hold: dict, now: float, stale_days: float) -> list[str]:
    """Why this hold itself needs a human look. A hold suppresses the report
    that would otherwise surface its branch, so an un-reviewable hold decays
    into a permanent quiet veto that outlives everyone who knew why it was
    placed — these flags are what make that decay LOUD instead of silent."""
    flags: list[str] = []
    if not hold.get("by"):
        flags.append("UNOWNED(no hold_by — nobody can release it)")
    if not hold.get("until"):
        flags.append("NO-RELEASE-CONDITION(no hold_until — cannot expire)")
    age = hold_age_days(hold, now)
    if age is None:
        flags.append("AGE-UNKNOWN(no parseable hold_since)")
    elif age > stale_days:
        flags.append(f"STALE({age:.1f}d > {stale_days:g}d)")
    return flags


def describe_hold(hold: dict, now: float, stale_days: float) -> str:
    """The per-cadence HELD line. Carries all four fields chuck required —
    held, BY WHOM, SINCE WHEN, UNTIL WHAT — plus the review flags, so a fresh
    manager reading one sweep's output has everything needed to either respect
    or release the hold without any surviving tmux context."""
    age = hold_age_days(hold, now)
    age_txt = f"{age:.1f}d" if age is not None else "age-unknown"
    flags = hold_review_flags(hold, now, stale_days)
    flag_txt = f" [NEEDS REVIEW: {'; '.join(flags)}]" if flags else ""
    return (
        f"HELD — do NOT merge (deliberate, not stranded); "
        f"by={hold.get('by') or 'UNKNOWN'} "
        f"since={hold.get('since') or 'UNKNOWN'} ({age_txt}) "
        f"until={hold.get('until') or 'UNSTATED'} "
        f"reason={hold['reason']}"
        f"{flag_txt}"
    )


def hold_lift_hint(hold: dict) -> str:
    """The exact command that releases this hold. Printed with every held
    branch so releasing one never requires reading this source file."""
    bead = hold.get("bead") or "<work-bead>"
    return (f"to lift: bd update {bead} --sandbox --unset-metadata hold "
            f"--unset-metadata hold_by --unset-metadata hold_since "
            f"--unset-metadata hold_until")


_BEAD_ID_RE = re.compile(r"[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+(?:\.[0-9]+)*")


def parse_bead_id(branch: str) -> str | None:
    """Best-effort bead id embedded in a branch name. Strips a leading `wk-`
    worktree prefix, then returns the first bead-id-shaped token (e.g.
    `wk-SABLE-jfg6.3` -> `SABLE-jfg6.3`). Returns None when nothing id-shaped
    remains. A token that isn't a real bead id just makes the downstream
    `bd show` miss and fall through to `bd search` — harmless."""
    core = branch
    for pfx in ("wk-", "worktree-"):
        if core.startswith(pfx):
            core = core[len(pfx):]
            break
    m = _BEAD_ID_RE.search(core)
    return m.group(0) if m else None


def status_from_show_json(text: str) -> str | None:
    """Status out of a `bd show <id> --json` payload — accepts either a bare
    object or a single-element list (bd returns a list), None on any parse
    failure or empty result."""
    try:
        d = json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return None
    if isinstance(d, list):
        d = d[0] if d else None
    return d.get("status") if isinstance(d, dict) else None


def record_from_show_json(text: str) -> dict | None:
    """The WHOLE bead record out of a `bd show <id> --json` payload (bare object
    or single-element list). The record — not just its status — is what carries
    the hold metadata (SABLE-jejx3), so resolution returns the object and the
    status accessors read from it."""
    try:
        d = json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return None
    if isinstance(d, list):
        d = d[0] if d else None
    return d if isinstance(d, dict) else None


def all_records_from_search_json(text: str) -> list[dict]:
    """EVERY record in a `bd list`/`bd search --json` payload, in payload order.

    More than one bead can legitimately carry the same `branch` metadata (an
    observation/scratch bead filed against the same branch as the real work
    bead — this is not hypothetical; it is what the live corpus looks like).
    Predicate 2 only needs one status, but HOLD resolution must see them ALL:
    if any joined bead is held, the branch is held, and letting an arbitrary
    payload ordering decide would silently drop a hold and resume filing the
    inverted 'merge me' handoff — the exact defect this floor is fixing."""
    try:
        d = json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return []
    if isinstance(d, dict):
        d = [d]
    return [r for r in d if isinstance(r, dict)] if isinstance(d, list) else []


def first_record_from_search_json(text: str) -> dict | None:
    """The first whole record in a `bd list`/`bd search --json` payload (a
    list), None if empty/unparseable. Record-level counterpart of
    first_status_from_search_json."""
    try:
        d = json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return None
    if isinstance(d, dict):
        d = [d]
    if isinstance(d, list) and d and isinstance(d[0], dict):
        return d[0]
    return None


def first_status_from_search_json(text: str) -> str | None:
    """Status of the first hit in a `bd search --json` payload (a list), None if
    empty/unparseable."""
    try:
        d = json.loads(text)
    except (json.JSONDecodeError, ValueError):
        return None
    if isinstance(d, dict):
        d = [d]
    if isinstance(d, list) and d and isinstance(d[0], dict):
        return d[0].get("status")
    return None


RECONCILE_TITLE_PREFIX = "[RECONCILE] stranded merge: "
RECONCILE_TITLE_SUFFIX = " — no for-chuck handoff on record"
BRANCH_SHA_KEY = "branch_sha"


def reconcile_bead_title(branch: str) -> str:
    """The filed bead's title. The branch name is the idempotency key
    (predicate 3 / title_names_branch), so it MUST appear here, delimited."""
    return f"{RECONCILE_TITLE_PREFIX}{branch}{RECONCILE_TITLE_SUFFIX}"


def reconcile_bead_branch(title: str | None) -> str | None:
    """The branch named by a title THIS FLOOR ITSELF wrote, or None.

    The exact inverse of reconcile_bead_title, and deliberately strict: the
    auto-close leg (SABLE-rhsuj) may only retire beads of our OWN filing, whose
    stated condition is exactly the one it re-evaluates. A hook-filed
    [AUTO-NOTIFY] handoff, a hand-written coordination bead, or anything else
    that merely mentions a branch must return None — auto-closing a human's bead
    off a title match would retire an instruction whose premise we never
    checked."""
    if not isinstance(title, str):
        return None
    text = title.strip()
    if not text.startswith(RECONCILE_TITLE_PREFIX) or not text.endswith(RECONCILE_TITLE_SUFFIX):
        return None
    branch = text[len(RECONCILE_TITLE_PREFIX):len(text) - len(RECONCILE_TITLE_SUFFIX)].strip()
    return branch if branch and is_wk_branch(branch) else None


def bead_branch_sha(bead: dict | None) -> str | None:
    """The branch tip sha this floor RECORDED when it filed the bead
    (`branch_sha` metadata, written by record_branch_sha_metadata).

    This is what lets the auto-close stay a PRESENCE probe after a correct
    merge deletes the branch ref: the recorded sha is still an object in the
    repo (reachable from the spine precisely BECAUSE it merged), so containment
    is answerable without the ref existing. Without it the only probe left is
    "is the branch still on origin", which is the absence probe this whole fix
    exists to refuse."""
    if not isinstance(bead, dict):
        return None
    meta = bead.get("metadata")
    if not isinstance(meta, dict):
        return None
    sha = meta.get(BRANCH_SHA_KEY)
    return sha.strip() if isinstance(sha, str) and sha.strip() else None


def created_bead_id(text: str) -> str | None:
    """The id out of a `bd create --json` payload (bare object or single-element
    list). None on any parse failure — the follow-up metadata write is
    best-effort (matching sable-spawn-worker's governance writes), so an
    unparseable create response degrades the auto-close to the live-ref
    fallback; it never fails the filing."""
    rec = record_from_show_json(text)
    ident = rec.get("id") if isinstance(rec, dict) else None
    return ident if isinstance(ident, str) and ident.strip() else None


def reconcile_bead_description(branch: str, work_status: str | None,
                               branch_sha: str | None = None) -> str:
    sha_line = f"Branch-sha-at-filing: {branch_sha}\n" if branch_sha else ""
    return (
        "Filed by sable-reconcile-handoffs (SABLE-jfg6.3 / D3), the pull-based "
        "reconciliation floor: this branch is pushed to origin and UNMERGED, its "
        f"work bead is {work_status}, and NO for-chuck bead named it — the "
        "push-based post-push-merge-notify handoff never reached Chuck (research "
        "F4 notify-miss). Treat exactly as a hook-filed handoff.\n"
        f"\nBranch: {branch}\n"
        f"{sha_line}"
        "\nThis condition is RE-EVALUATED AT READ TIME (SABLE-rhsuj): every "
        "cadence re-probes whether the recorded sha is now CONTAINED in the "
        "integration branch and auto-closes this bead with the landing sha when "
        "it is. It is never retired on the branch merely being GONE from origin "
        "— that is an absence probe and it decays toward releasing a genuine "
        "strand.\n"
        "\n## Acceptance Criteria\n"
        "- Inspect the branch on origin and merge into the integration branch "
        "(or hold with reason)\n"
        "- Close this bead on merge\n"
    )


# --------------------------------------------------------------------------
# HELD-ON-MATCHED-PAIR (SABLE-tseoz's ruling, carried into SABLE-rhsuj).
#
# Five non-stranded states were catalogued across a seventeen-bead population
# with ZERO genuine strands. Four of them need inputs this floor genuinely does
# not have. THE FIFTH DOES NOT: a `land-together` serialization ruling is
# already structured, symmetric, queryable metadata on the work bead the branch
# belongs to, written specifically so automated checks could read it — and the
# reconciler filed a stranded bead for it anyway. So the leading step of this
# fix is not "design new discriminators", it is "read the one that already
# exists". Pure functions over an already-fetched bead record, like hold_*.
# --------------------------------------------------------------------------

SERIALIZE_KIND_KEY = "serialize_kind"
SERIALIZE_WITH_KEY = "serialize_with"
SERIALIZE_BRANCH_KEY = "serialize_branch"
SERIALIZE_REASON_KEY = "serialize_reason"
SERIALIZE_RULING_KEY = "serialize_ruling"

LAND_TOGETHER = "land-together"


def matched_pair_from_bead(bead: dict | None) -> dict | None:
    """The land-together ruling carried by a work bead, or None.

    Presence is keyed on `serialize_kind` being EXACTLY `land-together` — an
    explicit ruling that these branches must land as a unit, so neither is
    stranded while it waits for its partner. A bare `serialize_with` is
    deliberately NOT enough: the overlap hook writes that key to mean "sequence
    these two handoffs", which is a scheduling hint and not a do-not-merge-alone
    instruction, and keying on it would suppress every overlapping branch in the
    fleet. Same discipline as hold_from_bead: the remaining fields are detail,
    and their absence is reported rather than treated as a missing ruling."""
    if not isinstance(bead, dict):
        return None
    meta = bead.get("metadata")
    if not isinstance(meta, dict):
        return None
    kind = meta.get(SERIALIZE_KIND_KEY)
    if not isinstance(kind, str) or kind.strip() != LAND_TOGETHER:
        return None

    def _field(key: str) -> str | None:
        v = meta.get(key)
        return v.strip() if isinstance(v, str) and v.strip() else None

    return {
        "bead": bead.get("id"),
        "kind": LAND_TOGETHER,
        "with": _field(SERIALIZE_WITH_KEY),
        "branch": _field(SERIALIZE_BRANCH_KEY),
        "reason": _field(SERIALIZE_REASON_KEY),
        "ruling": _field(SERIALIZE_RULING_KEY),
    }


def describe_matched_pair(pair: dict) -> str:
    """The per-cadence HELD-ON-MATCHED-PAIR line. Carries the partner, the
    ruling and the reason so a fresh seat can either respect the pairing or
    escalate it without reading this source file — the same standard
    describe_hold meets for holds."""
    return (
        "HELD-ON-MATCHED-PAIR — do NOT merge alone (deliberate land-together "
        "ruling, not stranded); "
        f"with={pair.get('with') or 'UNSTATED'} "
        f"pair-branch={pair.get('branch') or 'UNSTATED'} "
        f"ruling={pair.get('ruling') or 'UNSTATED'} "
        f"reason={pair.get('reason') or 'UNSTATED'} "
        f"[on work bead {pair.get('bead') or 'UNKNOWN'}]"
    )


# --------------------------------------------------------------------------
# Command plumbing (env-seam overridable — mirrors sable-merge-gate)
#
# SABLE-6sdpx AUDIT: every _git/_bd call in this file runs with check=False.
# All but one already inspect .returncode right at (or immediately after) the
# call site and fall through to the CONSERVATIVE branch on failure — merged-
# or-unresolvable stays not-stranded (branch_ancestor_rc / ancestor_rc_is_
# unmerged), an unresolvable age/status returns None and the branch is left
# for the next sweep (branch_tip_age_seconds, find_work_bead_status), and a
# failed bead write is a loud caller-side WARNING (file_for_chuck_bead, see
# reconcile()). The one exception — the reconcile()-level `git fetch --prune`
# refresh, which discarded its CompletedProcess outright — is fixed below.
# --------------------------------------------------------------------------

def _tool(env_name: str, default: str) -> list[str]:
    return os.environ.get(env_name, default).split()


def _run(argv: list[str], *, cwd: str, check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        argv, cwd=cwd, text=True, check=check,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )


def _git(repo: str, *args: str, check: bool = False) -> subprocess.CompletedProcess:
    return _run(_tool("SABLE_RC_GIT", "git") + list(args), cwd=repo, check=check)


def _bd(repo: str, *args: str, check: bool = False) -> subprocess.CompletedProcess:
    return _run(_tool("SABLE_RC_BD", "bd") + list(args), cwd=repo, check=check)


def _tmux(repo: str, *args: str, check: bool = False) -> subprocess.CompletedProcess:
    return _run(_tool("SABLE_RC_TMUX", "tmux") + list(args), cwd=repo, check=check)


# --------------------------------------------------------------------------
# Systems-of-record queries (git + beads, behind the pure predicates)
# --------------------------------------------------------------------------

def list_origin_wk_branches(repo: str, remote: str) -> list[str]:
    """Bare `wk-*` branch names published on <remote>, from the local
    remote-tracking refs (caller fetch --prune's first). The remote/ prefix is
    stripped so downstream qualify_remote_ref sees a bare name."""
    cp = _git(repo, "for-each-ref", "--format=%(refname:short)",
              f"refs/remotes/{remote}/wk-*", check=False)
    if cp.returncode != 0:
        return []
    out: list[str] = []
    prefix = f"{remote}/"
    for line in cp.stdout.splitlines():
        short = line.strip()
        if not short:
            continue
        name = short[len(prefix):] if short.startswith(prefix) else short
        if is_wk_branch(name):
            out.append(name)
    return out


def resolve_base_sha(repo: str, remote: str, integration_branch: str) -> str | None:
    """PIN the integration branch to ONE sha, once, at sweep start (SABLE-q0e3n).

    The straddle defect: every containment probe used to name the REF
    (`refs/remotes/<remote>/<base>`) and git re-resolved it on every single
    invocation. A promote landing mid-sweep — or any other process in this repo
    running its own `git fetch` — moves that ref UNDER THE SWEEP, so branch A is
    judged against the pre-landing spine and branch B against the post-landing
    one. Measured live: three already-merged branches were reclassified HELD /
    QUEUED-AT-SEAT in the run that straddled a landing, and back to merged in
    the run after. Resolving once and passing the SHA everywhere makes one
    sweep's verdicts internally consistent by construction — a sha cannot move.

    None when the base does not resolve at all; callers WARN and fall back to
    the ref name (a degraded-but-running sweep that says so beats a silent one).
    Note this pin is deliberately NOT the whole q0e3n remedy: a pinned sha is
    consistent but can be STALE by the end of a long sweep, which is exactly why
    the filing path re-fetches and re-verifies containment immediately before
    `bd create` (see reverify_containment_before_filing)."""
    ref = qualify_remote_ref(remote, integration_branch)
    cp = _git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", check=False)
    sha = cp.stdout.strip() if cp.returncode == 0 else ""
    return sha or None


def object_exists(repo: str, rev: str) -> bool:
    """Does `rev` resolve to a commit object in this repo?

    THE EXISTENCE PRECONDITION (SABLE-8b41.8). `git merge-base --is-ancestor`
    against a ref/sha git cannot resolve exits 128, and the idiom that swallows
    it (`... || echo NOT CONTAINED`) reports a correct merge as lost. Running
    this FIRST means a non-zero containment rc downstream can only mean a real
    negative answer, and an unresolvable object becomes COULD-NOT-ASSESS —
    its own outcome — instead of a confident wrong one in either direction."""
    if not rev:
        return False
    cp = _git(repo, "cat-file", "-e", f"{rev}^{{commit}}", check=False)
    return cp.returncode == 0


def sha_contained_in_base(repo: str, sha: str | None,
                          base_sha: str | None) -> tuple[str, str]:
    """THE PRESENCE PROBE the auto-close is keyed on: is `sha`'s content already
    reachable from the pinned base sha? Returns (verdict, detail) using the
    three-valued containment vocabulary above.

    Deliberately keyed on a SHA rather than on a branch ref, and never on the
    branch ref's EXISTENCE. A correct merge is routinely followed by the branch
    being deleted from origin; keying on the ref would make cleanup, a bad push
    or a rename indistinguishable from a landing, and every one of those would
    retire a genuinely stranded merge. A sha that merged is reachable from the
    spine, so it stays probeable forever — that asymmetry is the whole reason
    the recorded `branch_sha` exists."""
    if not sha:
        return (CONTAINMENT_UNASSESSABLE, "no-branch-sha-on-record")
    if not base_sha:
        return (CONTAINMENT_UNASSESSABLE, "base-sha-unresolved")
    if not object_exists(repo, sha):
        return (CONTAINMENT_UNASSESSABLE,
                f"object-not-in-repo({sha}) — could not assess, NOT a negative answer")
    if not object_exists(repo, base_sha):
        return (CONTAINMENT_UNASSESSABLE,
                f"base-object-not-in-repo({base_sha}) — could not assess")
    rc = _git(repo, "merge-base", "--is-ancestor", sha, base_sha, check=False).returncode
    verdict = containment_verdict_from_rc(rc)
    if verdict == CONTAINED:
        return (CONTAINED, f"{sha} is contained in {base_sha}")
    if verdict == NOT_CONTAINED:
        return (NOT_CONTAINED, f"{sha} is NOT contained in {base_sha}")
    return (CONTAINMENT_UNASSESSABLE, f"is-ancestor rc={rc}")


def branch_ancestor_rc(repo: str, remote: str, branch: str, integration_branch: str,
                       base_sha: str | None = None) -> int:
    """`git merge-base --is-ancestor origin/<branch> <base>` return code
    (0 merged, 1 unmerged, other error). The branch ref is fully qualified via
    the reused qualify_remote_ref anti-ambiguity guard.

    `base_sha` is the sweep-pinned integration sha (SABLE-q0e3n). When supplied
    it is used INSTEAD of the base ref name, so a spine move mid-sweep cannot
    change this branch's answer relative to its siblings'. Defaults to None
    (re-resolve the ref) so every pre-existing call site behaves exactly as
    before."""
    branch_ref = qualify_remote_ref(remote, branch)
    base_ref = base_sha or qualify_remote_ref(remote, integration_branch)
    cp = _git(repo, "merge-base", "--is-ancestor", branch_ref, base_ref, check=False)
    return cp.returncode


def branch_tip_age_seconds(repo: str, remote: str, branch: str, now: float) -> float | None:
    """Push-age proxy: (now - committer date of origin/<branch> tip). The commit
    time is the only push-age signal cheaply available from a fetched
    remote-tracking ref (mirrors sable-merge-gate sweep's committerdate keying).
    None on any resolution failure — an unresolvable age fails predicate 4."""
    ref = qualify_remote_ref(remote, branch)
    cp = _git(repo, "log", "-1", "--format=%ct", ref, check=False)
    if cp.returncode != 0:
        return None
    try:
        return now - float(cp.stdout.strip())
    except ValueError:
        return None


def preview_ref_age_seconds(repo: str, sha: str, now: float) -> float | None:
    """Age of a ci-verify preview ref's commit, given its SHA (already
    resolved via remote_ref_commit's `ls-remote`). Reads the commit LOCALLY
    (`git log -1 --format=%ct <sha>`, no network) — reconcile()'s own blanket
    `git fetch <remote> --prune` at the top of every sweep already pulled the
    object regardless of which local ref name it landed under, since a
    fetch's default refspec covers every `refs/heads/*` including ci-verify/*.
    None on any resolution failure (SABLE-xw32f's queued check fails open on
    this exactly like branch_tip_age_seconds does for predicate 4)."""
    cp = _git(repo, "log", "-1", "--format=%ct", sha, check=False)
    if cp.returncode != 0:
        return None
    try:
        return now - float(cp.stdout.strip())
    except ValueError:
        return None


def find_work_bead_records(repo: str, branch: str) -> tuple[list[dict], bool]:
    """ALL work-bead records joined to the branch, plus whether resolution was
    READABLE.

    Returns (records, resolved_ok). `resolved_ok` is False only when the
    resolution machinery ITSELF failed (the structured metadata query exited
    nonzero and no fallback produced a record) — i.e. "we could not read", as
    opposed to "we read fine and there is no bead" (None, True). Predicate 2
    (status) can safely collapse those two, because an unresolvable status
    conservatively leaves the branch not-stranded either way. HOLD state cannot:
    collapsing unreadable into not-held is precisely how the floor would resume
    filing an inverted 'merge me' handoff against a held branch, so
    find_work_bead_hold keeps the distinction and reports it.

    Resolution order is unchanged from SABLE-i5739 — see find_work_bead_status
    for the full rationale of why structured metadata is primary. What DID
    change (SABLE-jejx3) is arity: the metadata leg returns EVERY joined bead
    rather than only the first, because a hold on any of them holds the branch
    (see all_records_from_search_json)."""
    resolvable_failure = False
    cp = _bd(repo, "list", "--status", "all",
             "--metadata-field", f"branch={branch}", "--json", check=False)
    if cp.returncode != 0:
        resolvable_failure = True
        print(f"sable-reconcile-handoffs: WARNING branch-metadata resolution "
              f"failed for {branch} (bd list exit {cp.returncode}) — falling "
              f"back to legacy resolution, NOT treating this as "
              f"no-qualifying-bead: {cp.stdout.strip()}", file=sys.stderr)
    else:
        recs = [r for r in all_records_from_search_json(cp.stdout)
                if r.get("status") is not None]
        if recs:
            return (recs, True)

    bead_id = parse_bead_id(branch)
    if bead_id:
        cp = _bd(repo, "show", bead_id, "--json", check=False)
        if cp.returncode == 0:
            rec = record_from_show_json(cp.stdout)
            if rec is not None and rec.get("status") is not None:
                return ([rec], True)

    cp = _bd(repo, "search", branch, "--status", "all", "--json", check=False)
    if cp.returncode == 0:
        rec = first_record_from_search_json(cp.stdout)
        if rec is not None:
            return ([rec], True)
        return ([], not resolvable_failure)
    return ([], not resolvable_failure)


def find_work_bead(repo: str, branch: str) -> tuple[dict | None, bool]:
    """The branch's PRIMARY work-bead record (the first joined bead) plus
    whether resolution was readable — the single-record view predicate 2 uses."""
    recs, ok = find_work_bead_records(repo, branch)
    return (recs[0] if recs else None, ok)


def find_work_bead_hold(repo: str, branch: str) -> dict | str | None:
    """The branch's HOLD state (SABLE-jejx3). Three distinct outcomes, never two:

      * a hold record  — the branch is deliberately held; do NOT file, DO report
      * None           — the work bead read fine and carries no hold
      * HOLD_UNKNOWN   — the bead could not be read at all, so 'held' can be
                         neither confirmed nor ruled out. Reported as its own
                         outcome; the floor does not file against it, because
                         filing an INVERTED handoff for a genuinely held branch
                         is unrecoverable-by-automation in a way that deferring
                         one cadence of a real strand is not — and unlike a
                         silent skip, this one says so in the summary.

    The hold is read from the WORK BEAD, so it survives a branch rename: the
    bead's `branch` metadata is re-pointed and the hold travels with it.

    EVERY bead joined to the branch is consulted, not just the first: a hold on
    any of them holds the branch. Ordering must never decide whether a hold is
    honoured (the live corpus routinely has an observation bead joined to the
    same branch as the real work bead, and it can sort first)."""
    records, ok = find_work_bead_records(repo, branch)
    if not ok:
        return HOLD_UNKNOWN
    for rec in records:
        hold = hold_from_bead(rec)
        if hold is not None:
            return hold
    return None


def find_work_bead_matched_pair(repo: str, branch: str) -> dict | None:
    """The branch's HELD-ON-MATCHED-PAIR state (SABLE-tseoz's ruling), or None.

    EVERY bead joined to the branch is consulted, exactly as find_work_bead_hold
    does and for the same reason: an observation/scratch bead routinely joins
    the same branch as the real work bead and can sort first, so ordering must
    never decide whether a land-together ruling is honoured.

    Unreadability is NOT reported separately here. The caller resolves the hold
    first, and an unreadable work bead is already HOLD_UNKNOWN, which
    short-circuits classification before this state is ever reached — so a None
    from here always means 'read fine, no land-together ruling', never 'could
    not read'."""
    records, ok = find_work_bead_records(repo, branch)
    if not ok:
        return None
    for rec in records:
        pair = matched_pair_from_bead(rec)
        if pair is not None:
            return pair
    return None


def find_work_bead_status(repo: str, branch: str) -> str | None:
    """The branch's work-bead status (predicate 2). Resolution order
    (SABLE-i5739 — prose-search closed as the primary resolver):

      1. STRUCTURED metadata: `bd list --metadata-field branch=<branch>
         --status all --json` — an EXACT key/value match against the
         `branch` metadata field sable-spawn-worker now writes on every
         bead at dispatch time (see tag_branch_metadata there). This is the
         PRIMARY path and, once a bead carries the field, the ONLY path
         consulted: an unrelated bead whose title/description merely
         mentions the branch text can never win here (closes mode b — WRONG
         SUCCESS), and the answer cannot drift as such beads accumulate
         later (closes mode c — DRIFT), because bead-carried metadata
         identity, not prose content, is what is being matched. A branch
         whose bead text never names it at all still resolves correctly
         (closes mode a — SILENT FAILURE), since this path never reads
         title/description.
      2. Embedded bead id in the branch name (`bd show`) — a pure
         convenience for a branch that happens to carry a bead id token;
         unaffected by this change.
      3. LEGACY prose `bd search` fallback — reached ONLY when neither of
         the above resolves anything, i.e. a branch dispatched BEFORE the
         metadata field existed. Prose-fragile by construction (the exact
         defect this bead closes), but every branch dispatched going
         forward always carries the metadata field, so this path retires
         naturally as old branches merge or expire; it is kept only so
         already-pushed pre-fix branches are not made WORSE (silently
         un-strandable) than they were before.

    A failed metadata query (nonzero bd exit) is NEVER silently folded into
    "no bead" — falling through unresolved-but-loud would leave the branch
    un-strandable with zero operator signal, one of the exact modes this
    bead fixes for the metadata path itself. It's printed as a loud WARNING
    (mirroring reconcile()'s git-fetch-failure WARNING) so 'nothing
    stranded' (query ran clean, found nothing) is never confused with
    'resolution failed' (the query itself is broken) — dispatch note #8.

    Thin accessor over find_work_bead (SABLE-jejx3 moved the resolution
    itself there so the SAME resolver serves both status and hold — one
    resolution order, one place to change it)."""
    bead, _ = find_work_bead(repo, branch)
    return bead.get("status") if isinstance(bead, dict) else None


def open_for_chuck_beads(repo: str) -> list[dict] | None:
    """Open + in-progress `for-chuck` beads (predicate 3's corpus). in_progress
    included so a handoff Chuck has already STARTED still suppresses a duplicate.

    Returns None — NOT [] — when the query itself failed (nonzero bd exit or
    unparseable JSON), so a transient bd failure is never indistinguishable
    from 'genuinely zero open handoffs'. Unlike find_work_bead_status's
    metadata query (SABLE-i5739), where a silent 'no bead' makes a branch
    un-strandable and the safe fallback is to WARN-AND-CONTINUE, an empty
    result HERE is predicate 3's suppression signal: reconcile() files a
    for-chuck bead only when this corpus does NOT already name the branch.
    Folding query-failure into empty would make the sweep FILE A DUPLICATE
    into chuck's queue — not self-correcting, unlike skipping one cadence."""
    cp = _bd(repo, "list", "--status", "open,in_progress",
             "--label", "for-chuck", "--json", check=False)
    if cp.returncode != 0:
        print(f"sable-reconcile-handoffs: WARNING for-chuck bead query failed "
              f"(bd list exit {cp.returncode}) — treating the corpus as "
              f"UNKNOWN, not empty, so this cadence skips filing rather than "
              f"risk a duplicate handoff: {cp.stdout.strip()}", file=sys.stderr)
        return None
    try:
        d = json.loads(cp.stdout)
    except (json.JSONDecodeError, ValueError):
        print(f"sable-reconcile-handoffs: WARNING for-chuck bead query "
              f"returned unparseable JSON — treating the corpus as UNKNOWN, "
              f"not empty, so this cadence skips filing rather than risk a "
              f"duplicate handoff", file=sys.stderr)
        return None
    return [b for b in d if isinstance(b, dict)] if isinstance(d, list) else []


def branch_tip_sha(repo: str, remote: str, branch: str) -> str | None:
    """The origin branch tip's sha, or None when it does not resolve. Recorded
    on every filed bead (see record_branch_sha_metadata) so the auto-close leg
    can probe containment of the CONTENT later, after a correct merge has
    deleted the ref."""
    ref = qualify_remote_ref(remote, branch)
    cp = _git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", check=False)
    sha = cp.stdout.strip() if cp.returncode == 0 else ""
    return sha or None


def file_for_chuck_bead(repo: str, branch: str, work_status: str | None,
                        branch_sha: str | None = None) -> subprocess.CompletedProcess:
    """File ONE for-chuck,coord bead naming the branch. ALWAYS --sandbox
    (SABLE-rq9k: local-only write, no Dolt auto-push — the chuck-only push lane
    stays intact). `--json` so the caller can recover the new id and stamp the
    branch sha on it (SABLE-rhsuj)."""
    return _bd(
        repo, "create", "--sandbox", "--json",
        "--title", reconcile_bead_title(branch),
        "--type=task", "--priority=2",
        "--labels=for-chuck,coord",
        "--description", reconcile_bead_description(branch, work_status, branch_sha),
        check=False,
    )


def record_branch_sha_metadata(repo: str, bead_id: str, branch_sha: str) -> bool:
    """Stamp `branch_sha=<sha>` on a freshly filed [RECONCILE] bead.

    This is what makes the bead's own condition RE-EVALUATABLE after the branch
    ref is gone: the recorded sha stays probeable because a merged commit is
    reachable from the spine. Best-effort, exactly like sable-spawn-worker's
    governance writes — a failed stamp degrades the auto-close for THIS bead to
    the live-ref fallback (and, once the ref is deleted, to a reported
    COULD-NOT-ASSESS that leaves it open); it never fails the filing, because a
    filed-but-unstampable handoff is still strictly better than no handoff."""
    cp = _bd(repo, "update", bead_id, "--sandbox",
             "--set-metadata", f"{BRANCH_SHA_KEY}={branch_sha}", check=False)
    return cp.returncode == 0


def close_reconcile_bead(repo: str, bead_id: str, reason: str) -> subprocess.CompletedProcess:
    """Auto-close ONE [RECONCILE] bead whose condition has been retired by a
    landing. `--sandbox` like every other write here (SABLE-rq9k)."""
    return _bd(repo, "close", bead_id, "--sandbox", "--reason", reason, check=False)


def autoclose_reason(branch: str, sha: str, base_sha: str, detail: str) -> str:
    """The close reason. It MUST carry the landing sha: the whole complaint
    behind SABLE-rhsuj is a bead asserting a present-tense condition with no
    evidence a reader can re-check, so its retirement has to be the opposite —
    a reader can re-run the named probe and get the same answer."""
    return (
        f"AUTO-CLOSED by sable-reconcile-handoffs (SABLE-rhsuj): the condition "
        f"this bead asserted has been retired by a correct action — {branch}'s "
        f"work is now CONTAINED in the integration branch. Landing sha: {sha} "
        f"contained in base {base_sha} ({detail}). Verified by a PRESENCE probe "
        f"(content contained at the spine), never by the origin branch being "
        f"gone — an absence probe would retire a genuinely stranded merge that "
        f"was deleted for cleanup, a bad push or a rename. Re-check with: "
        f"sable-contained {sha}"
    )


def branch_containment_for_autoclose(repo: str, remote: str, branch: str,
                                     integration_branch: str, recorded_sha: str | None,
                                     base_sha: str | None) -> tuple[str, str, str | None]:
    """Is this [RECONCILE] bead's branch now contained at the spine?

    Returns (verdict, detail, landing_sha) in the three-valued containment
    vocabulary. TWO presence legs, tried in order, and a bead is retired if
    EITHER answers CONTAINED:

      1. TIP CONTAINMENT of the sha recorded at filing time (falling back to the
         live origin tip for legacy beads filed before the stamp existed). This
         is the ordinary merge shape, and it survives the ref being deleted.
      2. PATCH-ID CONTAINMENT of the live branch ref (`git cherry`) — the
         REBASED-AND-LANDED shape, where every SHA changed so leg 1 cannot see
         the landing. Only available while the ref still exists; its absence
         simply means this leg sits out, never that the branch is uncontained.

    A bead is retired ONLY on an affirmative CONTAINED. NOT_CONTAINED leaves it
    open (a real strand, still waiting). CONTAINMENT_UNASSESSABLE — no recorded
    sha and no live ref, an object git cannot resolve, an unresolvable base —
    ALSO leaves it open, loudly. Could-not-assess is never folded into either
    verdict: folding it into CONTAINED would silently retire a strand whose
    evidence has simply been cleaned up, which is precisely the absence-probe
    failure this bead forbids."""
    sha = recorded_sha or branch_tip_sha(repo, remote, branch)
    verdict, detail = sha_contained_in_base(repo, sha, base_sha)
    if verdict == CONTAINED:
        return (CONTAINED, detail, sha)

    # Leg 2: the rebase-copy shape. Only meaningful while the ref lives — and
    # note this is still a PRESENCE probe (every unique commit is patch-id-
    # equivalent AT the spine), not an inference from the ref being absent.
    if branch_tip_sha(repo, remote, branch):
        rebased, rebase_detail = branch_content_contained(
            repo, remote, branch, integration_branch, base_sha)
        if rebased:
            return (CONTAINED, rebase_detail, sha or base_sha)

    return (verdict, detail, sha)


def autoclose_landed_reconcile_beads(
        repo: str, remote: str, integration_branch: str, base_sha: str | None,
        open_beads: list[dict] | None, dry_run: bool) -> tuple[list, list, list]:
    """SABLE-rhsuj's remedy: RE-EVALUATE AT READ TIME instead of trusting a
    present-tense assertion made at file time.

    Every cadence, walk the open for-chuck corpus, pick out the beads THIS FLOOR
    ITSELF filed (reconcile_bead_branch — never a hand-written or hook-filed
    handoff, whose premise we did not author and cannot re-check), and retire
    the ones whose branch is now contained at the spine, naming the landing sha.

    Why the condition needs this at all: it is retired by CORRECT ACTION —
    chuck merging the branch — which produces no failure event and no update to
    the bead, so nothing else ever invalidates it. Measured, the resulting
    false-alarm rate reached 100% across a shift, and the cost is not the
    individual false alarms (each fails safe) but the SKIMMING HABIT they train,
    which decays toward releasing the true positives.

    Returns (closed, kept, unassessable) — each a list of (bead_id, branch,
    detail) — so the caller can report all three. An UNREADABLE corpus
    (open_beads is None) closes NOTHING and says so: acting on a corpus we could
    not read is how a transient bd failure would become a bulk retirement."""
    closed: list[tuple[str, str, str]] = []
    kept: list[tuple[str, str, str]] = []
    unassessable: list[tuple[str, str, str]] = []
    if open_beads is None:
        return (closed, kept, unassessable)

    for bead in open_beads:
        if not isinstance(bead, dict):
            continue
        branch = reconcile_bead_branch(bead.get("title"))
        if not branch:
            continue
        bead_id = bead.get("id") or "<unknown>"
        verdict, detail, landing_sha = branch_containment_for_autoclose(
            repo, remote, branch, integration_branch, bead_branch_sha(bead), base_sha)

        if verdict != CONTAINED:
            row = (bead_id, branch, detail)
            (unassessable if verdict == CONTAINMENT_UNASSESSABLE else kept).append(row)
            continue

        reason = autoclose_reason(branch, landing_sha or "<unresolved>",
                                  base_sha or "<unresolved>", detail)
        if dry_run:
            closed.append((bead_id, branch, f"[dry-run] {detail}"))
            continue
        cp = close_reconcile_bead(repo, bead_id, reason)
        if cp.returncode == 0:
            closed.append((bead_id, branch, detail))
        else:
            unassessable.append((bead_id, branch,
                                 f"contained but close FAILED (bd exit "
                                 f"{cp.returncode}): {cp.stdout.strip()}"))
    return (closed, kept, unassessable)


def reverify_containment_before_filing(repo: str, remote: str, branch: str,
                                       integration_branch: str) -> tuple[str, str]:
    """SABLE-q0e3n part 3: the LAST thing checked before `bd create`.

    The pinned base sha (resolve_base_sha) makes one sweep internally
    consistent, but it is pinned at sweep START — a landing that happens DURING
    a long sweep leaves the pin stale, and the branch that just landed is
    exactly the one about to have a durable, unsatisfiable stranded handoff
    filed against it (the live SABLE-kiem2 instance: contained at the spine, ref
    already deleted, so the filed instruction could not be carried out at all).

    So the filing path re-fetches the integration ref, re-resolves it, and
    re-probes containment against that FRESH sha. A branch that comes back
    CONTAINED must never produce a stranded bead, whatever the classification
    said earlier in the sweep. Anything else — NOT_CONTAINED or
    COULD-NOT-ASSESS — proceeds to file, because the safe direction for a
    detector is to keep the alarm: a redundant handoff is visible and cheap to
    close, a suppressed real strand is neither."""
    _git(repo, "fetch", remote, integration_branch, check=False)
    fresh_base = resolve_base_sha(repo, remote, integration_branch)
    sha = branch_tip_sha(repo, remote, branch)
    verdict, detail = sha_contained_in_base(repo, sha, fresh_base)
    if verdict == CONTAINED:
        return (CONTAINED, f"{detail} (re-verified at filing time)")
    if sha:
        rebased, rebase_detail = branch_content_contained(
            repo, remote, branch, integration_branch, fresh_base)
        if rebased:
            return (CONTAINED, f"{rebase_detail} (re-verified at filing time)")
    return (verdict, detail)


def attempt_preview_kick(repo: str, remote: str, branch: str,
                         integration_branch: str) -> tuple[bool, str]:
    """Kick the SABLE-jd5fj.1 preview entrypoint for a branch whose push-time
    kick may have been missed (hook unwired, race, mid-flight crash). Delegates
    entirely to sable-merge-gate's `kick_preview`, which is ALREADY idempotent
    on the shared `preview_kick_ref` key (base_sha, branch_sha) — a ref that
    exists because the hook (or a prior poll run) already kicked it is a no-op
    read inside `kick_preview`, never a rebuild or a second CI trigger. That
    single shared key — not any dedup logic here — is what makes a hook-kicked
    and a poll-kicked preview mutually suppressing in EITHER race order (the
    columbo IDEMPOTENCY OVERLAP boundary case). Never raises: a missed or
    failed kick is a lost optimization, not a reconcile failure, so promote
    still builds its own preview later if this attempt never landed one."""
    try:
        rc = kick_preview(branch, integration_branch, repo, remote)
        return (rc == 0, "kick-ok(kicked-or-already-kicked)" if rc == 0 else f"kick-exit-{rc}")
    except Exception as exc:  # noqa: BLE001 — a kick failure must never abort the sweep
        return (False, f"kick-error:{exc}")


def live_pane_bead_ids(repo: str) -> set[str]:
    """Bead ids with a currently-LIVE tmux worker pane bound to them (SABLE-4709h
    IN-ACTIVE-REVISE discriminator — "1 IN ACTIVE REVISE — a live worker pane,
    bounced by its own manager (SABLE-660hy)" was one of sixteen false-positive
    firings a plain tip/handoff-bead classifier cannot tell apart from a real
    strand). A live pane tagged with a bead via @sable_bead means a manager
    already knows this branch's work is being actively reworked right now —
    filing a stranded handoff against it repeats the exact 'ask every lane,
    get a truthful not-mine from each' trap this floor exists to avoid, except
    here the answer WAS available, just not from bd or git.

    Fails OPEN to an EMPTY set — NEVER raises, never treated as unknown-and-
    suppress. sable-reconcile-timer's headless cadence deliberately runs with
    NO tmux server and NO pane context at all (SABLE-jd5fj.2 S5 walk-away
    path; see test_S5_U1_timer_once_catches_notify_miss_without_tmux_or_pane_
    context), so 'could not enumerate panes' must never make the floor stop
    reporting real strands the way an unreadable hold or for-chuck corpus
    does — it only means this ONE extra discriminator is unavailable this
    cadence; every other predicate still runs unchanged."""
    try:
        cp = _tmux(repo, "list-panes", "-a", "-F", _ws_pane_format, check=False)
    except (OSError, FileNotFoundError):
        return set()
    if cp.returncode != 0:
        return set()
    return _ws_live_beads(_ws_parse_fleet_panes(cp.stdout))


def branch_has_live_worker_pane(repo: str, branch: str, live_bead_ids: set[str]) -> bool:
    """True iff ANY bead joined to `branch` (every record find_work_bead_records
    resolves, plus a bead id embedded in the branch name itself — the same two
    sources the hold check consults) has a currently-live pane. Checked against
    the whole joined set, not just the primary work bead, for the same reason
    find_work_bead_hold does: an observation/scratch bead can be joined to the
    same branch and sort first, and a live pane on THAT bead is just as much
    in-active-revise as one on the primary."""
    if not live_bead_ids:
        return False
    records, _ = find_work_bead_records(repo, branch)
    ids = {r.get("id") for r in records if isinstance(r, dict) and r.get("id")}
    embedded = parse_bead_id(branch)
    if embedded:
        ids.add(embedded)
    return bool(ids & live_bead_ids)


def branch_content_contained(repo: str, remote: str, branch: str,
                             integration_branch: str,
                             base_sha: str | None = None) -> tuple[bool, str]:
    """SABLE-z7gue: does `branch`'s content already exist at the spine under a
    DIFFERENT sha — a REBASED-AND-LANDED branch whose original ref may still
    be a tip-keyed corpse (or, per z7gue's actual instance, whose ref was
    already deleted but a preview/tag/other tip-keyed probe still finds the
    pre-rebase commit). Ancestry (predicate 1, `git merge-base --is-ancestor`)
    is exactly wrong for this: it asks "is this exact SHA reachable from the
    integration branch", and a rebase changes every SHA, so a fully-landed
    rebase copy answers 'not an ancestor' IDENTICALLY to a genuinely stranded
    branch. 'ask both lanes' (SABLE-xw32f's remedy) cannot separate them
    either: every lane truthfully answers 'not mine', because the branch
    really is in nobody's hand — it is on the spine.

    Uses `git cherry <upstream> <head>` (z7gue's own suggested mechanism):
    each commit unique to `branch` is prefixed '-' when a patch-id-equivalent
    commit already exists in `integration_branch` (the exact rebase-copy
    relation), '+' when it is genuinely new. Returns (fully_contained, detail).

    fully_contained is True ONLY when EVERY commit unique to the branch is
    patch-id-equivalent — a PARTIALLY landed branch (some commits landed, some
    not) is conservatively left NOT-contained, per the module's stated
    default: this floor's stranded verdict is the ONE place its own remedy is
    a WRITE to the spine (re-merge), so an indeterminate/partial reading must
    fall through to the ordinary predicates rather than assert containment it
    cannot fully back. An unresolvable `git cherry` (nonzero exit) or an EMPTY
    result (ancestry already said unmerged, so a genuinely empty cherry
    listing would mean the two views disagree) both return NOT-contained —
    never invent a landed verdict off a failed or ambiguous comparison.

    `base_sha` is the sweep-pinned integration sha (SABLE-q0e3n) — supplied, it
    replaces the base REF here for the same reason it does in
    branch_ancestor_rc: both halves of one sweep's containment verdict must be
    computed against the SAME spine, or a mid-sweep landing makes the tip check
    and the patch-id check disagree about which spine they were asked about."""
    branch_ref = qualify_remote_ref(remote, branch)
    base_ref = base_sha or qualify_remote_ref(remote, integration_branch)
    cp = _git(repo, "cherry", base_ref, branch_ref, check=False)
    if cp.returncode != 0:
        return (False, f"patch-id-check-unresolvable(git cherry exit {cp.returncode})")
    lines = [ln for ln in cp.stdout.splitlines() if ln.strip()]
    if not lines:
        return (False, "patch-id-check-empty(no unique commits found)")
    new_commits = [ln for ln in lines if ln.startswith("+")]
    if new_commits:
        return (False, f"patch-id-partial({len(lines) - len(new_commits)} of "
                        f"{len(lines)} commit(s) patch-id-equivalent at the spine)")
    return (True, f"content-contained({len(lines)} commit(s) patch-id-equivalent "
                  f"at the spine under a different sha)")


DEFAULT_QUEUED_STALE_MIN = 120.0  # 2h — a preview should not run this long


def branch_queued_at_seat(repo: str, remote: str, branch: str, integration_branch: str,
                          now: float, queued_stale_min: float = DEFAULT_QUEUED_STALE_MIN,
                          base_sha: str | None = None) -> tuple[bool, str]:
    """SABLE-xw32f: is `branch` actively being processed at the merge seat
    RIGHT NOW — a ci-verify preview ref exists for its exact (base, branch)
    sha pair and Actions shows the run has not yet completed? Under burst
    load a branch legitimately queued for CI satisfies the ordinary stranded
    predicate IDENTICALLY to abandoned work (unmerged, work bead open/
    in-progress, no for-chuck handoff, past the settle window) — chuck's
    live incident was six such branches, all already in his hands, that a
    real (non-dry-run) sweep would have re-filed as fast as he closed them.

    Reuses the SAME shared idempotency key attempt_preview_kick's own no-op
    check already keys on (classify.preview_kick_ref, sable-merge-gate) — 'is
    this branch queued' and 'would kicking it be a no-op' resolve from the
    identical ref, one source of truth, not a second one invented here. Only
    covers the KICKED-preview ref scheme (hook or this floor's own poll leg);
    a preview built directly by `sable-merge-gate promote` uses a DIFFERENT
    ref-naming scheme keyed on the bead rather than the branch and is NOT
    covered by this check — a known scope gap, not silently dropped (bd q
    logged it).

    Deliberately does NOT treat `git cherry`'s '+' result as proof of
    anything (optimus's night-shift audit measured this directly): a
    patch-id changes across a rebase or conflict-resolution edit while the
    branch is genuinely queued at the seat, so a '+' from
    branch_content_contained is UNKNOWN, never STRANDED, until THIS or
    another discriminator resolves it — content-containment and queued-
    at-seat are complementary, not substitutable.

    AGE-BOUNDED (xw32f's own requirement, mirroring hold_since/hold_until on
    SABLE-jejx3's holds): a preview that has been in flight longer than
    `queued_stale_min` is exactly how a genuinely dropped branch would
    masquerade as in-progress forever, so QUEUED escalates back to the
    ordinary predicate rather than suppressing indefinitely. The clock here
    is the PREVIEW REF's own commit date, never the branch's own push age —
    a branch can be old (pushed long before this cadence) while its preview
    was kicked moments ago, and keying staleness on the branch's push age
    would misclassify a perfectly fresh queue as stale on every branch this
    floor's own settle window (predicate 4) already required to be old.

    Fails OPEN to NOT-QUEUED on any git/gh resolution failure (unresolvable
    sha, `gh` absent, an Actions API error or hang — ref_has_inflight_run is
    itself already fail-open) — never wedges the ordinary stranded predicate
    behind an unanswerable seat-status question.

    `base_sha` is the sweep-pinned integration sha (SABLE-q0e3n). The preview
    kick ref is keyed on the (base_sha, branch_sha) PAIR, so re-resolving the
    base here while the spine moves computes a ref name for a pair that never
    existed — the lookup misses, the branch reads NOT-QUEUED, and it falls
    through to the hold/strand path. That is one of the two ways the straddling
    sweep manufactured phantom queue entries, so this leg must use the same
    pinned sha every other containment probe in the sweep uses."""
    try:
        branch_ref = qualify_remote_ref(remote, branch)
        if not base_sha:
            base_sha = resolve_commit(repo, qualify_remote_ref(remote, integration_branch))
        branch_sha = resolve_commit(repo, branch_ref)
        ref = preview_kick_ref(branch, base_sha, branch_sha)
    except Exception as exc:  # noqa: BLE001 — an unresolvable sha must never crash the sweep
        return (False, f"queued-check-unresolvable({exc})")
    existing = remote_ref_commit(repo, remote, ref)
    if not existing:
        return (False, "no-preview-ref")

    ref_age = preview_ref_age_seconds(repo, existing, now)
    if ref_age is not None and ref_age > queued_stale_min * 60.0:
        return (False, f"queued-check-stale(preview ref age {ref_age:.0f}s "
                        f"exceeds {queued_stale_min}min queued-stale bound — "
                        f"escalating to ordinary classification)")

    if ref_has_inflight_run(repo, ref):
        return (True, f"QUEUED(preview {ref} in flight at the seat)")
    return (False, f"preview-ref-present-but-terminal({ref})")


# --------------------------------------------------------------------------
# Classification + orchestration
# --------------------------------------------------------------------------

def classify_branch(repo: str, remote: str, branch: str, integration_branch: str,
                    open_beads: list[dict] | None, threshold_minutes: float,
                    now: float, hold: dict | str | None = None,
                    stale_days: float = DEFAULT_HOLD_STALE_DAYS,
                    live_bead_ids: set[str] | None = None,
                    queued_stale_min: float = DEFAULT_QUEUED_STALE_MIN,
                    *,
                    base_sha: str | None = None,
                    contained: tuple[bool, str] | None = None,
                    matched_pair: dict | None = None
                    ) -> tuple[bool, str, str | None]:
    """Apply the stranded predicate to ONE branch. Returns (is_stranded, reason,
    work_status). Cheap/pure checks first; the bead-status lookup (a subprocess)
    runs only after ancestry + for-chuck rule the branch in as a live candidate.

    `hold` (SABLE-jejx3) is the branch's already-resolved hold state — a hold
    record, None for not-held, or HOLD_UNKNOWN for unreadable (see
    find_work_bead_hold). It is checked immediately after ancestry, BEFORE the
    remaining stranded predicates, because a deliberately-held branch satisfies
    every one of them and the handoff they would produce says the exact
    OPPOSITE of the standing instruction. It is resolved by the caller rather
    than here so reconcile() can also report it, held branches being a reported
    outcome and never a silent skip. Defaults to None so every pre-existing
    call site keeps its exact prior behavior.

    `live_bead_ids` (SABLE-4709h) is the whole fleet's set of bead ids with a
    currently-live tmux pane, resolved ONCE per sweep by the caller (mirrors
    `open_beads`) and checked immediately after HOLD, before predicate 3 — a
    branch actively being reworked in a live pane is exactly as much a
    reported non-strand as a held one, and for the same reason: filing a
    handoff would say the opposite of what is actually happening. Defaults to
    None (treated as empty) so every pre-existing call site keeps its exact
    prior behavior.

    Content-containment (SABLE-z7gue) is checked IMMEDIATELY AFTER ancestry
    and BEFORE the hold / live-pane / queued joins (SABLE-q0e3n moved it
    there): a branch whose commits are already patch-id-equivalent at the
    spine under a different sha is REBASED-AND-LANDED, not stranded —
    tip-containment (predicate 1) cannot see this, because a rebase changes
    every SHA. It has to lead because a HELD or QUEUED-AT-SEAT label on an
    already-landed branch is INCOHERENT and, worse, self-perpetuating: held
    branches are re-reported every cadence by design, so a spurious hold is
    permanent noise in the one report that must stay trustworthy. Deciding
    containment first means a landed branch can never reach those paths at
    all. `contained` may be supplied pre-computed by the caller so one sweep
    runs `git cherry` once per branch rather than twice.

    `matched_pair` (SABLE-tseoz) is the branch's land-together ruling, resolved
    by the caller from the SAME joined bead records as the hold and checked
    right after it — it is the same KIND of state (a deliberate decision not to
    merge yet, recorded as structured metadata) and needs the same treatment: a
    reported outcome, never a silent skip and never a stranded handoff."""
    rc = branch_ancestor_rc(repo, remote, branch, integration_branch, base_sha)
    if not ancestor_rc_is_unmerged(rc):
        return (False, f"merged-or-unresolvable(is-ancestor rc={rc})", None)

    if contained is None:
        contained = branch_content_contained(
            repo, remote, branch, integration_branch, base_sha)
    is_contained, contained_detail = contained
    if is_contained:
        return (False, f"landed-under-different-sha({contained_detail})", None)

    if hold == HOLD_UNKNOWN:
        return (False,
                "hold-state-unknown(work bead unreadable) — NOT filing: cannot "
                "rule out a deliberate do-not-merge hold", None)
    if isinstance(hold, dict):
        return (False, describe_hold(hold, now, stale_days), None)

    if isinstance(matched_pair, dict):
        return (False, describe_matched_pair(matched_pair), None)

    if branch_has_live_worker_pane(repo, branch, live_bead_ids or set()):
        return (False, "in-active-revise(a live worker pane is bound to this "
                        "branch's work bead)", None)

    # SABLE-xw32f: checked AFTER content-containment, deliberately, so a '+'
    # (not-yet-landed) reading from branch_content_contained is never treated
    # as proof of stranded on its own — a patch-id can change mid-queue (a
    # rebase or conflict-resolution edit while the branch sits at the seat),
    # so '+' means UNKNOWN, not stranded, until THIS check also clears.
    queued, queued_detail = branch_queued_at_seat(
        repo, remote, branch, integration_branch, now, queued_stale_min, base_sha)
    if queued:
        return (False, queued_detail, None)

    if branch_named_by_open_for_chuck(open_beads, branch):
        return (False, "handoff-already-on-record", None)

    status = find_work_bead_status(repo, branch)
    if not work_bead_qualifies(status):
        return (False, f"no-qualifying-work-bead(status={status})", status)

    age = branch_tip_age_seconds(repo, remote, branch, now)
    if age is None:
        return (False, "age-unresolvable", status)
    if not age_exceeds_threshold(age, threshold_minutes):
        return (False, f"too-fresh({age:.0f}s <= {threshold_minutes}min settle)", status)

    return (True, "STRANDED", status)


def reconcile(repo: str, remote: str, threshold_minutes: float, dry_run: bool,
              stale_days: float = DEFAULT_HOLD_STALE_DAYS,
              queued_stale_min: float = DEFAULT_QUEUED_STALE_MIN) -> int:
    integration_branch = resolve_integration_branch(repo)
    # Refresh remote-tracking refs so ancestry + age read origin's current
    # truth. SABLE-6sdpx: git exits nonzero here on a real network/auth
    # failure and NOT on "nothing new to fetch" (that is still exit 0), so a
    # nonzero rc always means the refresh did not happen — never a
    # legitimate no-op. A failed refresh is not fatal (the sweep can still
    # run stale-but-real local refs and will fetch again next cadence), but
    # it must be LOUD: silently classifying against stale refs looks
    # identical to a healthy sweep otherwise.
    fetch_cp = _git(repo, "fetch", remote, "--prune", check=False)
    if fetch_cp.returncode != 0:
        print(f"sable-reconcile-handoffs: WARNING git fetch {remote} --prune "
              f"failed (exit {fetch_cp.returncode}) — classifying against "
              f"POSSIBLY STALE remote-tracking refs: {fetch_cp.stdout.strip()}",
              file=sys.stderr)

    # SABLE-q0e3n part 1: PIN the spine ONCE, right after the refresh, and judge
    # every branch in this sweep against that single sha. Re-resolving the base
    # REF per branch is what let a concurrent promote move the spine mid-sweep
    # and reclassify three already-merged branches as HELD / QUEUED-AT-SEAT. A
    # base we cannot resolve is not fatal (the probes fall back to the ref name,
    # i.e. exactly the pre-fix behavior) but it IS loud, because the straddle
    # protection is off for that cadence and a silent degradation reads
    # identical to a protected one.
    base_sha = resolve_base_sha(repo, remote, integration_branch)
    if base_sha is None:
        print(f"sable-reconcile-handoffs: WARNING could not resolve a base sha "
              f"for '{integration_branch}' — classifying against the base REF "
              f"instead, so this cadence has NO protection against a spine move "
              f"mid-sweep (SABLE-q0e3n)", file=sys.stderr)

    branches = list_origin_wk_branches(repo, remote)
    open_beads = open_for_chuck_beads(repo)
    corpus_unknown = open_beads is None
    # SABLE-4709h: resolved ONCE per sweep, mirroring open_beads — a pane
    # enumeration per branch would be wasteful and (worse) could observe a
    # different fleet snapshot for different branches in the same cadence.
    live_bead_ids = live_pane_bead_ids(repo)
    now = time.time()

    mode = "DRY-RUN" if dry_run else "reconcile"
    print(f"sable-reconcile-handoffs [{mode}]: integration branch '{integration_branch}', "
          f"base sha {base_sha or 'UNPINNED'}, "
          f"{len(branches)} origin wk-* branch(es), age threshold {threshold_minutes}min")

    stranded: list[tuple[str, str | None]] = []
    held: list[tuple[str, dict]] = []
    hold_unreadable: list[str] = []
    matched: list[tuple[str, dict]] = []
    queued: list[str] = []
    unassessed = 0
    kick_candidates = 0
    kicked = 0
    for br in branches:
        if br == integration_branch:
            continue

        rc = branch_ancestor_rc(repo, remote, br, integration_branch, base_sha)

        # SABLE-q0e3n part 2: CONTAINMENT IS DECIDED FIRST, ahead of BOTH the
        # kick leg and the bead joins. A landed branch must never acquire a
        # HELD or QUEUED label, so the patch-id check runs here and its result
        # gates whether the hold and land-together joins happen at all — not
        # merely whether they win inside classify_branch. Computed once and
        # handed down, so one sweep runs `git cherry` once per branch.
        unmerged = ancestor_rc_is_unmerged(rc)
        contained = (branch_content_contained(repo, remote, br, integration_branch, base_sha)
                     if unmerged else (False, "not-evaluated(merged-or-unresolvable)"))
        live_candidate = unmerged and not contained[0]

        # Preview-kick leg (SABLE-jd5fj.2 / S5 poll leg): an ADDITIONAL,
        # independent classification pass — reuses P1/P4 only (see
        # preview_kick_eligible), never touches the stranded predicate below.
        # It DOES, however, respect content-containment: q0e3n measured three
        # extra preview kicks on already-merged branches in the straddling run,
        # and burning CI on work that is already at the spine is pure waste —
        # the speed epic exists to reduce exactly this. Tip-ancestry (rc) never
        # sees a rebased-and-landed branch, so without this the kick leg warms
        # CI for a merge that happened days ago.
        if unmerged and contained[0]:
            kick_eligible, kick_reason = (False, f"content-contained({contained[1]})")
        else:
            kick_age = branch_tip_age_seconds(repo, remote, br, now) if unmerged else None
            kick_eligible, kick_reason = preview_kick_eligible(rc, kick_age, threshold_minutes)
        if kick_eligible:
            kick_candidates += 1
            if dry_run:
                print(f"  {br}: [dry-run] would attempt preview-kick ({kick_reason})")
            else:
                ok, detail = attempt_preview_kick(repo, remote, br, integration_branch)
                if ok:
                    kicked += 1
                print(f"  {br}: preview-kick {detail}")

        # HOLD state (SABLE-jejx3) — resolved here, not inside classify_branch,
        # because a held branch is a REPORTED outcome, not a suppressed one, so
        # the sweep needs the record itself. Resolved only for branches that
        # cleared P1 AND are not already contained: a landed branch is nobody's
        # concern, held or not.
        hold = find_work_bead_hold(repo, br) if live_candidate else None
        # HELD-ON-MATCHED-PAIR (SABLE-tseoz) — only when the hold read CLEAN, so
        # a None from here can never be an unreadable bead masquerading as
        # 'no ruling' (HOLD_UNKNOWN already short-circuits classification).
        matched_pair = (find_work_bead_matched_pair(repo, br)
                        if live_candidate and hold is None else None)

        is_stranded, reason, status = classify_branch(
            repo, remote, br, integration_branch, open_beads, threshold_minutes,
            now, hold, stale_days, live_bead_ids, queued_stale_min,
            base_sha=base_sha, contained=contained, matched_pair=matched_pair)
        print(f"  {br}: {reason}")
        if isinstance(hold, dict):
            held.append((br, hold))
        elif hold == HOLD_UNKNOWN:
            hold_unreadable.append(br)
        if isinstance(matched_pair, dict):
            matched.append((br, matched_pair))
        if reason.startswith("QUEUED("):
            queued.append(br)
        if is_stranded:
            stranded.append((br, status))
        elif corpus_unknown and reason == "handoff-already-on-record":
            # predicate 3 assumed-named this branch only because the for-chuck
            # corpus query failed (branch_named_by_open_for_chuck(None, ...) is
            # unconditionally True) — its real strandedness was never actually
            # checked. Count it so the summary can say so instead of reading
            # identical to a fleet where nothing is stranded.
            unassessed += 1

    filed = 0
    landed_at_filing_time: list[tuple[str, str]] = []
    for br, status in stranded:
        # SABLE-q0e3n part 3: the LAST gate before a DURABLE write. Everything
        # above was classified against a base pinned at sweep start; a landing
        # that happened during the sweep leaves that pin stale, and this is the
        # branch it would file an unsatisfiable handoff for (SABLE-kiem2: the
        # work contained, the ref already deleted, so the instruction could not
        # be carried out at all). Re-fetch, re-resolve, re-probe. Only an
        # affirmative CONTAINED suppresses the filing.
        verdict, detail = reverify_containment_before_filing(
            repo, remote, br, integration_branch)
        if verdict == CONTAINED:
            landed_at_filing_time.append((br, detail))
            print(f"  {br}: LANDED DURING THIS SWEEP — filing SUPPRESSED "
                  f"({detail}); classified stranded against the sweep-start "
                  f"base, contained against the live one")
            continue

        if dry_run:
            print(f"  [dry-run] would file for-chuck bead for {br} (work bead {status})")
            continue
        branch_sha = branch_tip_sha(repo, remote, br)
        cp = file_for_chuck_bead(repo, br, status, branch_sha)
        if cp.returncode == 0:
            filed += 1
            print(f"  filed for-chuck bead for stranded branch {br}")
            # Stamp the tip sha so the auto-close leg can re-evaluate this
            # bead's own condition later, even after a correct merge deletes
            # the ref (SABLE-rhsuj). Best-effort — never fails the filing.
            bead_id = created_bead_id(cp.stdout)
            if bead_id and branch_sha and not record_branch_sha_metadata(repo, bead_id, branch_sha):
                print(f"  WARNING: could not stamp {BRANCH_SHA_KEY} on {bead_id} — "
                      f"its auto-close will fall back to the live origin ref and, "
                      f"once that ref is gone, report could-not-assess")
        else:
            print(f"  WARNING: could not file for-chuck bead for {br} "
                  f"(bd exit {cp.returncode}): {cp.stdout.strip()}")

    # SABLE-rhsuj: RE-EVALUATE AT READ TIME. Every [RECONCILE] bead this floor
    # filed asserts a present-tense condition that is retired by CORRECT ACTION
    # (chuck merging it) — an event that produces no failure, no signal and no
    # update, so without this leg the bead simply outlives its own premise. The
    # cost is not the individual false alarms; it is that a detector whose
    # output is mostly already-done trains the seat to SKIM, and skimming decays
    # toward releasing the true positives.
    ac_closed, ac_kept, ac_unassessable = autoclose_landed_reconcile_beads(
        repo, remote, integration_branch, base_sha, open_beads, dry_run)
    if ac_closed or ac_unassessable:
        print(f"  --- [RECONCILE] AUTO-CLOSE ({len(ac_closed)} retired, "
              f"{len(ac_kept)} still stranded, {len(ac_unassessable)} unassessable) ---")
    for bead_id, br, detail in ac_closed:
        verb = "would auto-close" if dry_run else "AUTO-CLOSED"
        print(f"  {verb} {bead_id} ({br}): condition retired by a landing — {detail}")
    for bead_id, br, detail in ac_unassessable:
        print(f"  COULD NOT ASSESS {bead_id} ({br}): {detail} — left OPEN, because "
              f"could-not-assess is never a landing (and the branch being GONE is "
              f"never one either)")

    # SABLE-jejx3: HELD branches are RE-REPORTED, loudly, every single cadence.
    # This recap exists in addition to the per-branch line above because a hold
    # is self-silencing by construction — it suppresses the strand report that
    # would otherwise keep its branch visible — so the one thing this floor must
    # never do is let a hold quietly become permanent. Naming every held branch
    # with by/since/until/reason and the exact lift command makes a forgotten
    # hold as visible as a forgotten strand.
    review_needed = 0
    if held:
        print(f"  --- HELD BRANCHES ({len(held)}) — deliberate, do NOT merge; "
              f"re-reported every cadence by design ---")
        for br, hold in held:
            flags = hold_review_flags(hold, now, stale_days)
            if flags:
                review_needed += 1
            print(f"  HELD {br}: {describe_hold(hold, now, stale_days)}")
            print(f"       {hold_lift_hint(hold)}")
    for br in hold_unreadable:
        print(f"  HOLD-STATE UNREADABLE {br}: work bead could not be read — "
              f"neither held nor not-held could be established, so nothing was "
              f"filed for it this cadence")

    # SABLE-xw32f: QUEUED branches are NAMED, not silently skipped — the exact
    # constraint SABLE-2az2x's instrument-cannot-say-'could-not-assess' lesson
    # and jejx3's hold re-report both established: a suppressed report must
    # never look identical to nothing-to-report. 'the seat is busy' has its
    # own visible line, every cadence.
    # SABLE-tseoz: land-together branches get the same treatment as holds —
    # NAMED every cadence, never a silent skip. Its whole point is that the
    # discriminating signal already existed and was simply not consulted; a
    # discriminator that suppresses without reporting would repeat that
    # invisibility in the other direction.
    if matched:
        print(f"  --- HELD ON A MATCHED PAIR ({len(matched)}) — land-together "
              f"ruling, do NOT merge alone; not stranded ---")
        for br, pair in matched:
            print(f"  MATCHED-PAIR {br}: {describe_matched_pair(pair)}")

    if queued:
        print(f"  --- QUEUED AT THE SEAT ({len(queued)}) — preview in flight, "
              f"already owned; not stranded ---")
        for br in queued:
            print(f"  QUEUED {br}")

    # SABLE-2az2x: an UNKNOWN for-chuck corpus makes the reconciler assume-named
    # (skip-filing) for every unmerged branch it sees, cadence after cadence, if
    # the underlying query failure is PERSISTENT rather than transient — and the
    # summary below would otherwise print the exact same "0 stranded, 0 filed"
    # a genuinely healthy fleet prints. That is indistinguishable-from-healthy,
    # which is worse than the duplicate handoff the suppression prevents (a
    # duplicate is visible and reconcilable; a silently-stopped floor is not).
    # Suppression itself stays unbounded here (per-cadence WARNING already
    # covers the transient case) — this only makes the SUMMARY say so.
    corpus_note = (
        f" (CORPUS UNREADABLE — suppression active, {unassessed} branch(es) unassessed)"
        if corpus_unknown else ""
    )
    # SABLE-jejx3: the summary carries the held count too — the three outcomes
    # this floor can now report are STRANDED, HELD, and could-not-assess, and a
    # summary that named only the first would be the two-state instrument this
    # bead exists to retire. Held branches are NAMED, not just counted, so one
    # grep of the summary line answers "what is deliberately not merging".
    held_note = ""
    if held:
        names = ", ".join(br for br, _ in held)
        held_note = f" [{names}]"
        if review_needed:
            held_note += f" ({review_needed} NEEDING REVIEW)"
    if hold_unreadable:
        held_note += (f"; {len(hold_unreadable)} branch(es) with UNREADABLE "
                      f"hold state [{', '.join(hold_unreadable)}]")
    held_summary = f"{len(held)} held branch(es){held_note}"
    queued_note = f" [{', '.join(queued)}]" if queued else ""
    queued_summary = f"{len(queued)} queued-at-seat branch(es){queued_note}"
    matched_note = f" [{', '.join(br for br, _ in matched)}]" if matched else ""
    matched_summary = f"{len(matched)} matched-pair branch(es){matched_note}"
    # SABLE-rhsuj/q0e3n: both new legs report a COUNT in the summary line even
    # when zero, so 'the auto-close ran and retired nothing' can never be
    # confused with 'the auto-close did not run' — the same
    # indistinguishable-from-healthy trap SABLE-2az2x's corpus note closes.
    autoclose_summary = (
        f"{len(ac_closed)} [RECONCILE] bead(s) auto-closed as landed"
        f"{' (dry-run)' if dry_run else ''}"
        f"{f' [{len(ac_unassessable)} unassessable, left open]' if ac_unassessable else ''}"
    )
    suppressed_summary = (
        f"; {len(landed_at_filing_time)} filing(s) SUPPRESSED by the pre-create "
        f"containment re-verify [{', '.join(br for br, _ in landed_at_filing_time)}]"
        if landed_at_filing_time else ""
    )

    if dry_run:
        print(f"sable-reconcile-handoffs [DRY-RUN]: {len(stranded)} stranded branch(es) "
              f"classified, 0 filed (dry-run){corpus_note}; {held_summary}; "
              f"{matched_summary}; {queued_summary}; {autoclose_summary}; "
              f"{kick_candidates} preview-kick candidate(s), 0 kicked (dry-run)"
              f"{suppressed_summary}.")
    else:
        print(f"sable-reconcile-handoffs: {len(stranded)} stranded branch(es), "
              f"{filed} for-chuck bead(s) filed{corpus_note}; {held_summary}; "
              f"{matched_summary}; {queued_summary}; {autoclose_summary}; "
              f"{kick_candidates} preview-kick candidate(s), {kicked} kicked"
              f"{suppressed_summary}.")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="sable-reconcile-handoffs")
    parser.add_argument("--repo", default=os.environ.get("SABLE_RC_REPO", os.getcwd()))
    parser.add_argument("--remote", default=os.environ.get("SABLE_RC_REMOTE", "origin"))
    parser.add_argument("--age-min", type=float,
                        default=float(os.environ.get("SABLE_RECONCILE_AGE_MIN", "10")),
                        help="push-age threshold in minutes before a branch is "
                             "eligible for reconciliation (default 10; "
                             "SABLE_RECONCILE_AGE_MIN)")
    parser.add_argument("--hold-stale-days", type=float,
                        default=float(os.environ.get(
                            "SABLE_HOLD_STALE_DAYS", str(DEFAULT_HOLD_STALE_DAYS))),
                        help="a hold older than this many days is flagged "
                             "NEEDING REVIEW in the summary so it cannot decay "
                             "into a permanent quiet veto (default 3; "
                             "SABLE_HOLD_STALE_DAYS)")
    parser.add_argument("--queued-stale-min", type=float,
                        default=float(os.environ.get(
                            "SABLE_QUEUED_STALE_MIN", str(DEFAULT_QUEUED_STALE_MIN))),
                        help="a branch queued at the seat (preview in flight) "
                             "longer than this many minutes escalates back to "
                             "ordinary classification instead of suppressing "
                             "indefinitely (default 120; SABLE_QUEUED_STALE_MIN)")
    parser.add_argument("--dry-run", action="store_true",
                        help="classify + print only; file no beads; exit 0")
    args = parser.parse_args(argv)
    return reconcile(args.repo, args.remote, args.age_min, args.dry_run,
                     args.hold_stale_days, args.queued_stale_min)


if __name__ == "__main__":
    sys.exit(main())
